(ns icare.ui.screens.pages
  (:require ["package:flutter/material.dart" :as m]
            [icare.ui.screens.pages.queridos.base :as queridos]
            [icare.ui.screens.pages.list.base :as list]
            [icare.ui.drawing :as drawing]
            [cljd.flutter :as f]))

(defn state->ast [db]
  {:id "pages"
   :ui-type ::base
   :home-page (queridos/state->ast db)
   :list-page (list/state->ast db)})

(defn ast-store->widget [ast-store side-effects]
  (f/widget
   (m/PageView
    ;; the drawing overlay derives its screen context (:home vs :my-list) from
    ;; which page is showing, and watches this controller to slide drawings
    ;; horizontally along with the page swipe
    .controller (drawing/page-controller)
    .onPageChanged (fn [idx] (reset! drawing/page-index idx) nil)
    .children [(queridos/ast-store->widget ast-store side-effects)
               (list/ast-store->widget ast-store side-effects)])))
