(ns icare.ui.screens.pages.queridos.todo-list
  (:require ["package:flutter/material.dart" :as m]
            ["package:flutter_svg/flutter_svg.dart" :as svg]
            ["package:reorderable_grid/reorderable_grid.dart" :as reorderable-grid]
            ["dart:ui" :as ui]
            ["dart:math" :refer [sqrt]]
            [icare.datafriend :as df]
            [icare.ui.drawing :as drawing]
            [icare.ui.screens.pages.shared :refer [hsv get-phone-measurements autoscroll-away-from-keyboard]]
            [icare.ui.screens.pages.queridos.shared :refer [home-icon-asset home-icon-title
                                                            animated-sliver-fade animated-fade]]
            [cljd.flutter :as f]))

(defn task [db querido-id [task-id task]]
  (let [{:keys [task/title task/completed task/is-add-task?]} task
        ;; a friend's task lives in their (read-only) namespace, so our "like" is a
        ;; separate entity in our OWN db keyed by the task's uuid, synced under our
        ;; namespace. Read the like from our own :eav, not the friend's task.
        liked (get-in db [:eav task-id :like/liked] false)]
    (if is-add-task?
      {:ui-type ::add-task-task
       :key task-id
       :id (str "add-task-task-" querido-id)}
      {:ui-type ::task
       :key task-id
       :id (str "querido-task-" task-id)
       :title title
       :liked liked
       :on-like (fn [side-effects]
                  (fn []
                    (let [{:keys [transact! render!]} side-effects]
                      ;; write the like into our own namespace (transact! also syncs it up)
                      (transact! {'add {task-id {:like/liked (not liked)}}})
                      (render!))))
       :completed completed})))

(defn ui-list [db querido-id]
  (let [{:keys [querido/name querido/asset querido/pub-key]} (-> (df/query db {querido-id {:querido/pub-key 'pk :querido/name 'n :querido/asset 'a}})
                                                                 vals
                                                                 first)
        task-order (get-in db [pub-key :eav :global/config :config/todo-list-order])
        animated-assets (get-in db [:eav :global/config :config/animated-assets])
        all-tasks       (mapv (fn [task-id] [task-id (get-in db [pub-key :eav task-id])]) task-order)]
    {:id (str "list-base-" querido-id)
     :ui-type ::list
     :pub-key pub-key
     :on-reorder-tasks (fn [side-effects]
                         (fn [old-idx new-idx]
                           (let [adjusted-new-idx (if (> new-idx old-idx) (dec new-idx) new-idx)] ;; Flutter's reorderable lists return strange indices, this is us dealing with that
                             (let [{:keys [transact! render!]} side-effects
                                   moved-task-id       (nth task-order old-idx)
                                   tasks-without-moved (vec (concat (subvec task-order 0 old-idx)
                                                                    (subvec task-order (inc old-idx))))
                                   reordered-tasks     (vec (concat (subvec tasks-without-moved 0 adjusted-new-idx)
                                                                    [moved-task-id]
                                                                    (subvec tasks-without-moved adjusted-new-idx)))]
                               (transact! {'add {querido-id {:querido/task-order reordered-tasks}}})
                               (render!)))))
     :on-edit-list-title (fn [side-effects]
                           (fn [new-name]
                             (let [{:keys [transact! render!]} side-effects]
                               (transact! {'add {querido-id {:querido/name new-name}}})
                               (render!))))
     ;;submitting an empty name deletes the querido (same pattern as tasks), so this must only be wired to onSubmitted, never onChanged
     :on-submit-list-title (fn [side-effects]
                             (fn [new-name]
                               (let [{:keys [transact! render!]} side-effects]
                                 (if (empty? new-name)
                                   ;;retracting the whole entity includes its pose, which removes it from the canvas
                                   (transact! {'retract (into {querido-id (get-in db [:eav querido-id])
                                                               :global/config {:config/expanded-querido querido-id}}
                                                              (map (fn [task-id] [task-id (get-in db [:eav task-id])]))
                                                              (remove #(= % :add-task-task) task-order))})
                                   (transact! {'add {querido-id {:querido/name new-name}}}))
                                 (render!))))
     :on-edit-asset (fn [side-effects]
                      (fn [new-asset]
                        (let [{:keys [transact! render!]} side-effects]
                          (transact! {'add {querido-id {:querido/asset new-asset}}})
                          (render!))))
     :asset-picker {:ui-type ::asset-picker ;;we share one asset picker across all lists, since only one list is opened at a time, no need to have multiple copies
                    :id "asset-picker"
                    :current-asset asset
                    :on-reorder-assets (fn [side-effects]
                                         (fn [old-idx new-idx]
                                           (let [{:keys [transact! render!]} side-effects
                                                 moved-asset (nth animated-assets old-idx)
                                                 assets-without-moved (vec (concat (subvec animated-assets 0 old-idx)
                                                                                   (subvec animated-assets (inc old-idx))))
                                                 reordered-assets (vec (concat (subvec assets-without-moved 0 new-idx)
                                                                               [moved-asset]
                                                                               (subvec assets-without-moved new-idx)))]
                                             (transact! {'add {:global/config {:config/animated-assets reordered-assets}}})
                                             (render!))))
                    :on-select-asset (fn [side-effects]
                                       (fn [new-asset]
                                         (let [{:keys [transact! render!]} side-effects]
                                           (transact! {'add {querido-id {:querido/asset new-asset}}})
                                           (render!))))
                    :asset-list animated-assets}
     :asset asset
     :title name
     :tasks (mapv (partial task db querido-id) all-tasks)}))

(def task-padding {:left 30 :bottom 0})

(def ^m/TextStyle task-text-style (m/TextStyle
                                   .color m/Colors.black
                                   .fontFamily "Inter"
                                   .fontWeight m/FontWeight.normal
                                   .fontSize 20))

(def title-style (m/TextStyle
                   .color m/Colors.black
                   .fontSize 22))

(defn ast-store->widget
  ([side-effects ast-store id]
   (let [recursive-call (fn [ast-id]
                          ;; (prn "ast-store->widget called with ast-id: " ast-id)
                          (ast-store->widget side-effects ast-store ast-id))
         get-ast-atom #(get @ast-store id)
         {:keys [key ui-type]} @(get-ast-atom)]
     (condp = ui-type
       ::list
       (f/widget
        :context ctx
        :get [:icon-transition-controller :expanded-icon-atom]
        :let [{:keys [title pub-key]} @(get-ast-atom)
              {:keys [notch-height phone-height phone-width]} (get-phone-measurements ctx)
              content-start (/ (+ notch-height 50) phone-height)
              {:keys [image-coords text-coords]} @expanded-icon-atom
              image-destination ^m/Offset (:position image-coords)
              image-size        ^m/Size   (:size image-coords)
              title-destination ^m/Offset (:position text-coords)
              title-size        ^m/Size   (:size text-coords)
              curved                                   (m/CurvedAnimation .parent icon-transition-controller .curve m/Curves.easeInSine)
              t                                        (.drive curved (m/Tween .begin 0.0 .end 1.0))]
        :managed [list-title-controller (m/TextEditingController .text title)]
        ;; borrowed from the drawing registry (which owns it, never disposed) so
        ;; the overlay can anchor this list's strokes to its scroll position
        :let [scroll-controller (drawing/scroll-controller-for pub-key)]
        :bind {:scroll-controller scroll-controller
               :image-coords image-coords
               :text-coords text-coords}
        :watch [{:keys [tasks]} (get-ast-atom)]
        ;;callbacks are fetched from the node atom at event time, a build-time :let would capture a closure over stale db data
        :let [title (f/widget
                     (m/SizedBox .width (.-width title-size) .height (.-height title-size))
                     (home-icon-title .controller list-title-controller
                                       .enabled true
                                       .onSubmitted (fn [new-name]
                                                      (if (empty? new-name)
                                                        ;;submitting an empty name deletes the querido, collapse the expanded view first, same dance as the deexpand drag in queridos base
                                                        (.then (.reverse icon-transition-controller)
                                                               (fn [_]
                                                                 (reset! expanded-icon-atom nil)
                                                                 (((:on-submit-list-title @(get-ast-atom)) side-effects) new-name)))
                                                        (((:on-submit-list-title @(get-ast-atom)) side-effects) new-name))
                                                      nil)
                                       .onChanged (fn [new-name]
                                                    (((:on-edit-list-title @(get-ast-atom)) side-effects) new-name))))
              image (f/widget
                     :watch [{:keys [asset]} (get-ast-atom)]
                     (m/GestureDetector
                      .behavior m/HitTestBehavior.opaque
                      .onTap (fn []
                               (m/showModalBottomSheet
                                .showDragHandle true
                                .context ctx
                                .builder (fn [_] (recursive-call "asset-picker")))
                               nil))
                     (home-icon-asset asset))]
        (m/Stack
         .children
         [(m/CustomScrollView
           .anchor content-start
           .controller scroll-controller
           .physics (m/AlwaysScrollableScrollPhysics)
           .slivers [(f/widget
                      (animated-sliver-fade
                       .controller icon-transition-controller)
                      (f/widget
                       (autoscroll-away-from-keyboard
                        .scrollController scroll-controller)
                       (m/SliverReorderableList
                        .itemBuilder (fn [_ idx] (recursive-call (nth tasks idx)))
                        .itemCount (count tasks)
                        .onReorder (fn [old-idx new-idx]
                                     (((:on-reorder-tasks @(get-ast-atom)) side-effects) old-idx new-idx)))))
                     (m/SliverToBoxAdapter
                      .child (m/SizedBox .height 400))])
          (m/Transform.translate
           .offset title-destination
           .child (f/widget
                   ;; fade the icon+title toward grey (1.0 -> 0.4) as the list expands
                   :watch [_ icon-transition-controller]
                   (m/Opacity .opacity (- 1.0 (* 0.6 (.-value t))))
                   title))
          (m/Transform.translate
           .offset image-destination
           .child (f/widget
                   :watch [_ icon-transition-controller]
                   (m/Opacity .opacity (- 1.0 (* 0.6 (.-value t))))
                   image))]))

       ::task
       (f/widget
        :key key
        :watch [{:keys [completed liked title]} (get-ast-atom)]
        :padding task-padding
        m/Row
        .children
        [(f/widget
          :padding {:top 2}
          (m/IconButton
           .icon (m/Icon (if completed
                           m/Icons.check_box
                           m/Icons.check_box_outline_blank)
                         .size 26
                         .color m.Colors/black)
           .onPressed nil))
         (f/widget
          (m/SizedBox .width 200)
          (m/Text title
                  .maxLines nil
                  .style task-text-style))
         (m/IconButton
          .icon (m/Icon (if liked m/Icons.favorite m/Icons.favorite_border)
                        .size 26
                        .color (if liked m/Colors.pink m/Colors.red))
          .onPressed (fn []
                       (((:on-like @(get-ast-atom)) side-effects))))])

       ::add-task-task
       (f/widget
        :key key
        :padding task-padding
        (m/Row)
        .children
        [(f/widget
          :padding {:top 2}
          (m/IconButton
           .icon (m/Icon m/Icons.check_box_outline_blank
                         .size 26
                         .color m/Colors.grey)
           .onPressed nil))])

       ::asset-picker
       (f/widget
        :watch [{:keys [asset-list current-asset]} (get-ast-atom)]
        :let [asset-icon (fn [asset-name]
                           (f/widget
                            :key asset-name
                            (m/Container
                             .decoration (m/BoxDecoration
                                          .border (m/Border.all .color (if (= current-asset asset-name) m/Colors.blue m/Colors.transparent) .width 2)))
                            (m/GestureDetector
                             .behavior m/HitTestBehavior.opaque
                             .onTap (fn []
                                      (((:on-select-asset @(get-ast-atom)) side-effects) asset-name)))
                            (m/Column)
                            .children
                            [(m/SizedBox .height 20)
                             (m/Image.asset
                              (str "assets/animated/" asset-name)
                              .fit m/BoxFit.contain
                              .width 40
                              .height 40)
                             (f/widget
                              (m/SizedBox .width 120)
                              (m/Text
                               asset-name
                               .textAlign m/TextAlign.center
                               .maxLines 3
                               .style (m/TextStyle
                                       .color m/Colors.black
                                       .fontSize 16)))]))]
        (m/Container
         .color m/Colors.white
         .height 400)
        (reorderable-grid/ReorderableGridView.count
         .scrollDirection m/Axis.horizontal
         .physics (m/AlwaysScrollableScrollPhysics)
         .crossAxisCount 4
         .childAspectRatio 0.7
         .proxyDecorator (fn [child _ _] child)
         .onReorder (fn [old-idx new-idx]
                      (((:on-reorder-assets @(get-ast-atom)) side-effects) old-idx new-idx))
         .children (mapv asset-icon asset-list)))

       (throw (Exception (str "Unknown ui-type in home page todo-list ast-store->widget: " @(get-ast-atom))))))))
