(ns icare.ui.screens.pages.queridos.base
  (:require ["package:flutter/material.dart" :as m]
            ["package:flutter/scheduler.dart" :as scheduler]
            ["package:flutter_svg/flutter_svg.dart" :as svg]
            ["package:flutter/services.dart" :as services]
            ["dart:ui" :as ui]
            [icare.ui.screens.pages.queridos.todo-list
             :refer [ui-list ast-store->widget]
             :rename {ast-store->widget expanded-icon->widget}]
            [icare.ui.screens.pages.shared :refer [get-phone-measurements autoscroll-away-from-keyboard]]
            [icare.ui.screens.pages.queridos.shared :refer [home-icon-asset home-icon-title animated-blur animated-fade debug-border ctx->coords scrim-opacity]]
            [icare.datafriend :as df]
            [icare.ui.physics :as physics]
            [icare.ui.drawing :as drawing]
            [cljd.flutter :as f]))

(defn add-querido [db]
  (let [config (get-in db [:eav :global/config])
        user-pub-key (:config/user-pub-key config)
        animated-assets (:config/animated-assets config)
        home-count (count (df/get-entities db {:attribute :position/canvas :value :home}))]
    {:ui-type ::add-querido
     :id "home-add-querido"
     :paste-content user-pub-key
     :on-add-pubkey (fn [side-effects]
                      (fn [pubkey]
                        (when-not (empty? pubkey)
                          (let [{:keys [transact! render! make-uuid pull-friend!]} side-effects
                                new-querido-id (make-uuid)
                                ;;spawn near the middle of the canvas and let repulsion shove everyone into place
                                spawn-x (+ 150.0 (* 40.0 (mod home-count 4)))
                                spawn-y (+ 320.0 (* 40.0 (mod home-count 3)))]
                            (transact! {'add {new-querido-id (merge {:querido/name "change-me"
                                                                     :querido/asset (get animated-assets (mod home-count (count animated-assets)))
                                                                     :querido/pub-key pubkey
                                                                     :querido/task-order []}
                                                                    (df/position-attributes :home spawn-x spawn-y))}})
                            (render!)
                            ;;pull them now rather than waiting on the watch loop: the /watch
                            ;;currently parked was registered without this pubkey, so no poke
                            ;;for it can reach us and the loop cannot even notice the new
                            ;;friend until that poll times out a minute later
                            (pull-friend! pubkey)))))}))

(defn icon [db expanded-querido-id [querido-id querido]]
  (let [{:keys [querido/name querido/asset position/x position/y]} querido
        is-expanded? (= querido-id expanded-querido-id)]
      {:ui-type ::icon
       :key querido-id
       :id (str "home-icon-" querido-id)
       :x x
       :y y
       :is-expanded? is-expanded?
       :asset asset
       :on-expand-icon (fn [side-effects]
                         (fn []
                           (let [{:keys [transact! render!]} side-effects]
                             (transact! {'add {:global/config {:config/expanded-querido querido-id}}})
                             (render!))))
       :title name}))

(defn state->ast [db]
  (let [config (get-in db [:eav :global/config])
        expanded-querido-id (:config/expanded-querido config)
        home-ids (sort (df/get-entities db {:attribute :position/canvas :value :home}))
        all-queridos (mapv (fn [querido-id] [querido-id (get-in db [:eav querido-id])]) home-ids)
        physics-config (into {} (map (fn [[k v]] [(keyword (name k)) v])) (get-in db [:eav :global/physics]))]
    {:id "home-base"
     :ui-type ::base
     :physics physics-config
     :add-querido (add-querido db)
     :expanded-icon (when expanded-querido-id
                      (ui-list db expanded-querido-id))
     :on-deexpand-icon (fn [side-effects]
                         (fn [& args]
                           (when expanded-querido-id
                             (let [{:keys [transact! render!]} side-effects]
                               (transact! {'retract {:global/config {:config/expanded-querido expanded-querido-id}}})
                               (render!)))))
     ;;sleep = commit, this is how settled simulation poses become durable facts
     :on-commit-poses (fn [side-effects]
                        (fn [id->xy]
                          (let [{:keys [transact! render!]} side-effects]
                            (transact! {'add (into {}
                                                   (map (fn [[querido-id [x y]]]
                                                          [querido-id (df/position-attributes :home x y)]))
                                                   id->xy)})
                            (render!))))
     :icons (mapv (partial icon db expanded-querido-id) all-queridos)}))

;; Widget stuff

(def icon-max-width 270)
(def icon-half-width 81.0)
(def icon-half-height 85.0)

(defn key->coords [^m/GlobalKey key]
  (let [box ^m/RenderBox (.findRenderObject (.-currentContext key))
        position (.localToGlobal box m/Offset.zero)
        size (.-size box)]
    {:position position :size size}))

(defn- stroke-segments
  "Flatten strokes into physics obstacle segments [x1 y1 x2 y2] in content px.
   Strokes are recorded every ~4px which is far finer than collision needs, so
   we resample every 4th point (plus the endpoint); a single-point stroke
   becomes a degenerate point segment."
  [strokes phone-width]
  (into []
        (mapcat
         (fn [{:keys [points]}]
           (let [n (count points)]
             (if (< n 2)
               []
               (let [sampled (loop [i 0 acc []]
                               (if (> (+ i 1) (dec n))
                                 acc
                                 (recur (+ i 8) (conj acc [(* (nth points i) phone-width)
                                                           (nth points (inc i))]))))
                     last-point [(* (nth points (- n 2)) phone-width) (nth points (dec n))]
                     sampled (if (= (peek sampled) last-point) sampled (conj sampled last-point))]
                 (if (< (count sampled) 2)
                   (let [[x y] (first sampled)] [[x y x y]])
                   (mapv (fn [[x1 y1] [x2 y2]] [x1 y1 x2 y2]) sampled (rest sampled))))))))
        strokes))


;;TODO maybe we want to scale up here also
(defn animated-content-fade [controller content]
  (let [curved (m/CurvedAnimation .parent controller .curve (m/Interval 0.3 1.0 .curve m/Curves.easeInOut))
        opacity (.drive curved (m/Tween .begin 0.0 .end 1.0))]
    (f/widget
     :watch [_ controller]
     (m/Opacity
      .opacity (.-value opacity))
     content)))

;; AST -> STORE stuff

(defn ast-store->widget
  ([ast-store side-effects] (ast-store->widget side-effects ast-store "home-base"))
  ([side-effects ast-store id]
   (let [recursive-call (fn [ast-id]
                          ;; (prn "ast-store->widget called with ast-id: " ast-id)
                          (ast-store->widget side-effects ast-store ast-id))
         get-ast-atom #(get @ast-store id)
         {:keys [key ui-type]} @(get-ast-atom)]
     (condp = ui-type
       ::base
       (f/widget
        :keep-alive true
        :key key
        :context ctx
        :let [{:keys [notch-height phone-height phone-width]} (get-phone-measurements ctx)
              ;;the canvas grows once it holds 8 icons and gains a row every 2 after,
              ;;so the count fully determines the scrollable height
              canvas-height (fn [icon-count]
                              (+ phone-height (* 180.0 (max 0 (quot (- icon-count 6) 2)))))
              ;;walls are soft springs, these bounds are where icon centers come to rest;
              ;;a smaller clearance lets icons settle lower toward the bottom of the screen
              bounds-for (fn [icon-count]
                           {:left 90.0
                            :top (+ notch-height 130.0)
                            :right (- phone-width 90.0)
                            :bottom (- (canvas-height icon-count) 240.0)})]
        :vsync clock
        :managed [icon-transition-controller (m/AnimationController
                                              .vsync clock
                                              .duration (Duration .milliseconds 300))
                  expanded-icon-atom (atom nil) :dispose nil
                  ;;the simulation owns positions while bodies are awake, the db owns them once they sleep
                  sim-state (atom {:world (physics/make-world (:physics @(get-ast-atom)) (bounds-for 0))
                                   :pose-atoms {}
                                   :prev-elapsed 0.0}) :dispose nil]
        :let [;;the drawing overlay crossfades strokes with the expand/collapse animation
              _ (reset! drawing/expand-transition icon-transition-controller)
              sync-bodies! (fn [icon-node-ids]
                             (swap! sim-state
                                    (fn [{:keys [world pose-atoms] :as sim}]
                                      (let [initial? (empty? (:bodies world))
                                            ;;a changed icon count can move the floor; sleeping
                                            ;;bodies near the old wall wake on their own once the
                                            ;;wall force disappears and net repulsion can move them
                                            world (let [new-bounds (bounds-for (count icon-node-ids))]
                                                    (if (= new-bounds (:bounds world))
                                                      world
                                                      (assoc world :bounds new-bounds)))
                                            wanted (into {}
                                                         (map (fn [node-id]
                                                                (let [{:keys [key x y]} @(get @ast-store node-id)]
                                                                  [key [x y]])))
                                                         icon-node-ids)
                                            ;;bodies restored from the db start asleep, later spawns start awake so they settle
                                            world (reduce (fn [world [querido-id [x y]]]
                                                            (if (get-in world [:bodies querido-id])
                                                              world
                                                              (physics/add-body world querido-id x y initial?)))
                                                          world
                                                          wanted)
                                            world (reduce (fn [world querido-id]
                                                            (if (contains? wanted querido-id)
                                                              world
                                                              (physics/remove-body world querido-id)))
                                                          world
                                                          (vec (keys (:bodies world))))
                                            pose-atoms (reduce (fn [pose-atoms [querido-id [x y]]]
                                                                 (if (get pose-atoms querido-id)
                                                                   pose-atoms
                                                                   (assoc pose-atoms querido-id (atom [(double x) (double y)]))))
                                                               pose-atoms
                                                               wanted)]
                                        (assoc sim :world world :pose-atoms pose-atoms)))))
              ;;home strokes are capsule walls: keep the world's obstacle segments
              ;;in sync with the drawn ink, waking everyone when the ink changes
              ;;so sleeping crowds react to new lines (and to erased ones)
              sync-obstacles! (fn [strokes-by-screen]
                                (let [segments (stroke-segments (get strokes-by-screen :home) phone-width)]
                                  (swap! sim-state
                                         (fn [sim]
                                           (if (= segments (get-in sim [:world :obstacles]))
                                             sim
                                             (update sim :world
                                                     (fn [world]
                                                       (-> world
                                                           (assoc :obstacles segments)
                                                           physics/wake-all))))))))
              commit-poses! (fn [slept-ids world]
                              (((:on-commit-poses @(get-ast-atom)) side-effects)
                               (into {}
                                     (map (fn [querido-id]
                                            (let [{:keys [x y]} (get-in world [:bodies querido-id])]
                                              [querido-id [x y]])))
                                     slept-ids)))
              tick! (fn [elapsed]
                      (let [{:keys [world prev-elapsed pose-atoms]} @sim-state
                            now (/ (.-inMicroseconds ^Duration elapsed) 1000000.0)
                            dt (- now prev-elapsed)]
                        (swap! sim-state assoc :prev-elapsed now)
                        (when-not (physics/all-asleep? world)
                          (let [new-world (physics/step world dt)
                                slept (physics/newly-slept world new-world)]
                            (swap! sim-state assoc :world new-world)
                            (doseq [[querido-id body] (:bodies new-world)]
                              (when-not (:sleeping? body)
                                (when-let [pose-atom (get pose-atoms querido-id)]
                                  (reset! pose-atom [(:x body) (:y body)]))))
                            (when (seq slept)
                              ;;push the final resting pose, then transact it as a durable fact
                              (doseq [querido-id slept]
                                (when-let [pose-atom (get pose-atoms querido-id)]
                                  (let [{:keys [x y]} (get-in new-world [:bodies querido-id])]
                                    (reset! pose-atom [x y]))))
                              (commit-poses! slept new-world))))))
              drag-api {:start! (fn [querido-id]
                                  (swap! sim-state update :world physics/begin-drag querido-id))
                        :move! (fn [querido-id x y]
                                 (swap! sim-state update :world physics/drag-to querido-id x y)
                                 (when-let [pose-atom (get (:pose-atoms @sim-state) querido-id)]
                                   (reset! pose-atom [x y])))
                        :end! (fn [querido-id vx vy]
                                (swap! sim-state update :world physics/end-drag querido-id vx vy))}]
        ;;this widget is keep-alive and lives for the whole app, so the ticker is never disposed
        :managed [ticker (scheduler/Ticker tick!) :dispose nil]
        :let [_ (.start ticker)]
        :bind {:expanded-icon-atom expanded-icon-atom
               :icon-transition-controller icon-transition-controller
               :sim-state sim-state
               :drag-api drag-api}
        (m/Stack
         .alignment m/Alignment.center)
        .children
        [(f/widget
          :watch [{:keys [icons]} (get-ast-atom)
                  ;;the drawing overlay's node carries the stroke data; watching it
                  ;;keeps the physics walls in step with drawing and erasing
                  {:keys [strokes-by-screen]} (or (get @ast-store "drawing-overlay") (atom nil))]
          :let [_ (sync-bodies! icons)
                _ (sync-obstacles! strokes-by-screen)]
          ;;the canvas scrolls vertically once icons outgrow the screen; the
          ;;drawing overlay borrows this controller so :home strokes and the
          ;;pen ride along. Dragging an icon still wins over scrolling, so
          ;;scrolling starts from empty canvas.
          (m/SingleChildScrollView
           .controller (drawing/scroll-controller-for :home))
          (m/SizedBox .width phone-width .height (canvas-height (count icons)))
          (m/Stack)
          .children (mapv recursive-call icons))
         (f/widget
          :context ctx
          :let [keyboard-to-bottom (.-bottom (m/MediaQuery.viewInsetsOf ctx))
                keyboard-height (if (pos? keyboard-to-bottom) (+ keyboard-to-bottom 10) 30)]
          (m/AnimatedPositioned
           .duration (Duration .milliseconds 100)
           .bottom (+ keyboard-height 20)
           .child (f/widget
                   (recursive-call (:add-querido @(get-ast-atom))))))
         (f/widget
          :watch [{:keys [expanded-icon]} (get-ast-atom)]
          :when expanded-icon
          (do
            (.forward icon-transition-controller)
            (m/Stack
             .children
             [(f/widget
               (animated-fade
                .controller icon-transition-controller
                .begin 0.5
                .end 1)
               (m/Container
                .color (m/Colors.white.withOpacity scrim-opacity)
                .width phone-width
                .height phone-height))
              (animated-blur icon-transition-controller)
              (m/GestureDetector
               .behavior m/HitTestBehavior.opaque
               .onHorizontalDragStart (fn [_]
                                        (.then (.reverse icon-transition-controller)
                                               (fn [_]
                                                 (reset! expanded-icon-atom nil)
                                                 (((:on-deexpand-icon @(get-ast-atom)) side-effects))))
                                        nil)
               .child (expanded-icon->widget side-effects ast-store expanded-icon))])))])

       ::icon
       (f/widget
        :key key
        :get [:expanded-icon-atom :sim-state :drag-api]
        :watch [{:keys [title asset is-expanded?]} (get-ast-atom)]
        :bypass (when is-expanded?
                 (m/SizedBox))
        ;;TODO maybe we don't want to use global keys here
        :managed [image-global-key (m/GlobalKey)                      :dispose nil
                  text-global-key  (m/GlobalKey)                      :dispose nil
                  text-controller (m/TextEditingController .text title)
                  drag-grab (atom nil) :dispose nil]
        :let [pose-atom (get (:pose-atoms @sim-state) key)
              drag-start (fn [details]
                           ;;remember where on the icon the finger grabbed it
                           (let [[x y] @pose-atom
                                 finger (.-globalPosition details)]
                             (reset! drag-grab [(- x (.-dx finger)) (- y (.-dy finger))])
                             ((:start! drag-api) key)))
              drag-move (fn [details]
                          (let [[grab-x grab-y] @drag-grab
                                finger (.-globalPosition details)]
                            ((:move! drag-api) key (+ (.-dx finger) grab-x) (+ (.-dy finger) grab-y))))
              drag-end (fn [details]
                         ;;hand the finger's velocity to the body, throws come for free
                         (let [v (.-pixelsPerSecond (.-velocity details))]
                           ((:end! drag-api) key (.-dx v) (.-dy v))))
              content (f/widget
                       (m/GestureDetector
                        .behavior m/HitTestBehavior.opaque
                        .onTap (fn []
                                 (((:on-expand-icon @(get-ast-atom)) side-effects))
                                 (reset! expanded-icon-atom {:image-coords (key->coords image-global-key)
                                                             :text-coords (key->coords text-global-key)}))
                        ;;paired axis recognizers instead of pan: a pan needs kPanSlop
                        ;;while the canvas scroll view only needs kTouchSlop, so pans
                        ;;lose vertical-ish drags to scrolling. Same-axis recognizers
                        ;;tie and the deeper one (the icon) wins; either callback gets
                        ;;the full 2D position so the drag follows the finger freely.
                        .onVerticalDragStart drag-start
                        .onVerticalDragUpdate drag-move
                        .onVerticalDragEnd drag-end
                        .onHorizontalDragStart drag-start
                        .onHorizontalDragUpdate drag-move
                        .onHorizontalDragEnd drag-end)
                       (m/SizedBox .width (* 2 icon-half-width) .height (* 2 icon-half-height))
                       (m/Column)
                       .children
                       [(m/SizedBox .height 20)
                        (f/widget
                         (m/Container
                          .key image-global-key)
                         (home-icon-asset asset))
                        (f/widget
                         (m/Material
                          .type m/MaterialType.transparency)
                         (m/SizedBox
                          .key text-global-key
                          .width (* 0.6 icon-max-width)
                          .height 70)
                         (home-icon-title .controller text-controller .enabled false))])]
        ;;only this inner widget rebuilds at frame rate, the icon content above is built per semantic change
        (f/widget
         :watch [[x y] pose-atom]
         (m/Positioned .left 0.0 .top 0.0)
         (m/Transform.translate .offset (m/Offset (- x icon-half-width) (- y icon-half-height)))
         content))

       ;;TODO add button to copy the pubkey to clipboard
       ::add-querido
       (f/widget
        :context ctx
        :managed [text-controller (m/TextEditingController)]
        (m/Column
         .crossAxisAlignment m/CrossAxisAlignment.start)
        .children
        [(m/Row
          .children
          [(f/widget
            (m/IconButton
             .iconSize 30
             .icon (m/Icon m/Icons.content_copy)
             .onPressed (fn []
                          (services/Clipboard.setData (services/ClipboardData. .text (:paste-content @(get-ast-atom))))
                          nil)))
           (f/widget
            (m/SizedBox .width 300)
            (m/TextField
             .textInputAction m.TextInputAction/done
             .maxLines 1
             .style (m/TextStyle
                     .fontSize 22
                     .fontWeight m/FontWeight.normal
                     .color m/Colors.black)
             .decoration (m/InputDecoration
                          .hintText "paste a friend's pubkey here v"
                          .hintStyle (m/TextStyle .fontSize 22
                                                  .fontWeight m/FontWeight.normal
                                                  .color m.Colors/grey)
                          .contentPadding (m/EdgeInsets.only .bottom -10))
             ;;this widget never rebuilds (nothing to watch), so we fetch the callback at event time,
             ;;a build-time :let would capture a closure over stale db data
             .onSubmitted (fn [pubkey]
                            (((:on-add-pubkey @(get-ast-atom)) side-effects) pubkey)
                            (.clear text-controller))
             .controller text-controller))])
         (m/Text "    ^ Copy your pubkey"
          .style (m/TextStyle
                  .fontSize 22
                  .fontWeight m/FontWeight.normal
                  .color m/Colors.grey)
          .textAlign m/TextAlign.start)])


       (throw (Exception (str "Unknown ui-type in home ast-store->widget: " @(get-ast-atom))))))))
