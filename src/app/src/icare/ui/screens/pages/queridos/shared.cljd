(ns icare.ui.screens.pages.queridos.shared
  (:require ["package:flutter/material.dart" :as m]
            ["package:flutter/rendering.dart" :as rendering]
            ["dart:ui" :as ui]
            ["dart:math" :refer [pi sqrt atan2 cos sin]]
            [cljd.flutter :as f]))

(defn home-icon-asset [asset]
  (m/Image.asset (str "assets/animated/" asset)
                 .fit m/BoxFit.contain
                 .width 80
                 .height 80))

(defn home-icon-title [.onSubmitted .onChanged .controller .enabled]
  (m/TextField
   .controller controller
   .enabled (not (false? enabled))
   .autocorrect false
   ;;no long-press word selection: contested gesture arenas can rob the field of
   ;;its tap-down and Flutter's selectWord then crashes on a null tap position
   .enableInteractiveSelection false
   .textInputAction m/TextInputAction.done
   .textAlign m/TextAlign.center
   .maxLines 3
   .onSubmitted onSubmitted
   .onChanged onChanged
   .decoration (m/InputDecoration
                .contentPadding m/EdgeInsets.zero
                .isDense true
                .border m/InputBorder.none)
   .style (m/TextStyle
            .color m/Colors.black
            .fontSize 22)))

(defn animated-blur
  ([controller]
   (f/widget
    :managed [curved          (m/CurvedAnimation .parent controller .curve m/Curves.easeInOut) :dispose nil
              blur-animation  (.drive curved (m/Tween .begin 0.0 .end 12))                     :dispose nil]
    :let [empty-space (m/SizedBox.shrink)]
    :watch [_ controller]
    (m/BackdropFilter
     .filter (ui/ImageFilter.blur .sigmaX (.-value blur-animation) .sigmaY (.-value blur-animation))
     .child empty-space)))
  ([controller blur-width blur-height]
   (f/widget
    :managed [curved          (m/CurvedAnimation .parent controller .curve m/Curves.easeInOut) :dispose nil
              blur-animation  (.drive curved (m/Tween .begin 0.0 .end 12))                     :dispose nil]
    :let [sized-space (m/Container .width blur-width .height blur-height .color m/Colors.transparent)]
    m/ClipRect
    :watch [_ controller]
    (m/BackdropFilter
     .filter (ui/ImageFilter.blur .sigmaX (.-value blur-animation) .sigmaY (.-value blur-animation))
     .child sized-space))))

(defn animated-fade
  "applies a fade in animation to a renderbox child"
  [.controller .begin .end .child]
  (let [curved (m/CurvedAnimation .parent controller .curve (m/Interval begin end .curve m/Curves.easeInOut))
        opacity (.drive curved (m/Tween .begin 0.0 .end 1.0))]
    (f/widget
     :watch [_ controller]
     (m/Opacity
      .opacity (.-value opacity))
     child)))

(defn animated-sliver-fade
  "applies a fade out animation to a sliver"
  [.controller .child]
  (let [curved (m/CurvedAnimation .parent controller .curve (m/Interval 0.3 1.0 .curve m/Curves.easeInOut))
        opacity (.drive curved (m/Tween .begin 0.0 .end 1.0))]
    (f/widget
     :watch [_ controller]
     (m/SliverOpacity
      .opacity (.-value opacity))
     .sliver
     child)))

(defn ctx->coords [^m/BuildContext context]
  (let [box (.findRenderObject context)]
    (when box
      (let [^m/RenderBox render-box box
            position (.localToGlobal render-box m/Offset.zero)
            size (.-size render-box)]
        {:position position :size size}))))

(defn debug-border [.child .color]
  (m/Container
   .decoration (m/BoxDecoration
                .border (m/Border.all .color (if color color m/Colors.red) .width 2))
   .child child))

;; render element used with fade-sliver
(deftype RenderFadeSliver
  [^:mutable ^double fadeStart
   ^:mutable ^double fadeExtent]
  :extends rendering/RenderProxySliver
  (paint [this ^m/PaintingContext context ^m/Offset offset]
   (let [constraints  ^rendering/SliverConstraints (.-constraints this)
         sliver-top   (- (.-viewportMainAxisExtent constraints)
                         (.-remainingPaintExtent constraints))
         cross        (.-crossAxisExtent constraints)
         paint-extent (.-paintExtent (.-geometry this))
         fade-end     (+ fadeStart fadeExtent)
         rect         (.& offset (m/Size cross paint-extent))]
     (if (>= sliver-top fade-end)
       (.paintChild context (.-child this) offset)
       (let [start-opacity             (.clamp (/ (- sliver-top fadeStart) fadeExtent) 0.0 1.0)
             start-stop                (.clamp (/ (- fadeStart sliver-top) paint-extent) 0.0 1.0)
             full-opacity-stop         (.clamp (/ (- fade-end sliver-top) paint-extent) 0.0 1.0)
             shader        (.createShader
                            (m/LinearGradient
                             .begin  m/Alignment.topCenter
                             .end    m/Alignment.bottomCenter
                             .colors [(m/Colors.black.withOpacity
                                       start-opacity)
                                      m/Colors.black]
                             .stops  [start-stop full-opacity-stop])
                            rect)]
         (.pushLayer context
                     (doto (rendering/ShaderMaskLayer)
                       (.-shader!    shader)
                       (.-maskRect!  rect)
                       (.-blendMode! m/BlendMode.dstIn))
                     (fn [^m/PaintingContext ctx ^m/Offset off]
                       (.paintChild ctx (.-child this) off))
                     offset))))))

(defn fade-sliver
  "takes a sliver child and applies a fade out gradient from the top of the screen to fadeStart + fadeExtent pixels down
  useful for making a sliver list fade out as it scrolls up.
  This should only be used with slivers. On regular widgets simply apply a shader mask."
  [.child .fadeExtent .fadeStart]
  (reify :extends (m/SingleChildRenderObjectWidget .child child)
    (createRenderObject [this ^m/BuildContext _ctx]
      (RenderFadeSliver fadeStart fadeExtent))
    (updateRenderObject [this ^m/BuildContext _ctx ^RenderFadeSliver ro]
      (.-fadeStart!  ro (double fadeStart))
      (.-fadeExtent! ro (double fadeExtent))
      nil)))

(defn rad->deg [rad]
  (* rad (/ 180 pi)))

(defn deg->rad [deg]
  (* deg (/ pi 180)))

(defn xy->rt [x y]
  (let [radius (sqrt (+ (* x x) (* y y)))
        rad (atan2 y x)
        degree (as-> (rad->deg rad) d
                 (if (< d 0) (+ d 360) d)
                 (mod (- d 90) 360)
                 (- 360 d)
                 (mod d 360))]
    [radius degree]))

(defn ^m/Offset rt->offset [radius degree]
  (let [rad (deg->rad degree)
        x (* radius (sin rad))
        y (* radius (cos rad))]
    (m/Offset x y)))

(defn lerp-polar [r1 theta1 r2 theta2 t]
  (let [dtheta (- theta2 theta1)
        dtheta (cond
                 (> dtheta 180)  (- dtheta 360)
                 (< dtheta -180) (+ dtheta 360)
                 :else           dtheta)
        r (+ r1 (* (- r2 r1) t))
        theta (+ theta1 (* dtheta t))]
    [r theta]))

(defn ^m/Offset lerp-polar-offsets [^m/Offset a ^m/Offset b t]
  (let [[ra ta] (xy->rt (.-dx a) (.-dy a))
        [rb tb] (xy->rt (.-dx b) (.-dy b))
        [r theta] (lerp-polar ra ta rb tb t)]
    (rt->offset r theta)))

(defn get-polar-lerp-from-offsets [^m/Offset a ^m/Offset b]
  (let [[ra ta] (xy->rt (.-dx a) (.-dy a))
        [rb tb] (xy->rt (.-dx b) (.-dy b))]
    (fn [t]
      (let [[r theta] (lerp-polar ra ta rb tb t)]
        (rt->offset r theta)))))
