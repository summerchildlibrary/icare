(ns icare.core
  (:require ["package:flutter/material.dart" :as m]
            ["package:google_fonts/google_fonts.dart" :as gf]
            ["package:flutter/services.dart" :as services]
            ["package:firebase_core/firebase_core.dart" :as firebase]
            ["firebase_options.dart" :as firebase-options]
            ["package:haptic_feedback/haptic_feedback.dart" :as haptics]
            ["package:firebase_messaging/firebase_messaging.dart" :as firebase-messaging]
            ["package:nostr/nostr.dart" :refer [Keychain]]
            ["package:flutter_secure_storage/flutter_secure_storage.dart" :refer [FlutterSecureStorage]]
            ["dart:isolate" :as isolate]
            ["dart:ui" :as dart-ui]
            ["package:uuid/uuid.dart" :refer [Uuid]]
            [cljd.flutter :as f]
            [cljd.dart.isolates :as isolates]
            [icare.datafriend :as df]
            [icare.storage :as storage]
            [icare.network :as network]
            [icare.ui :as ui]))

(def uuid-generator (.-v4 (Uuid)))

(defn default-initial-data [pub-key]
  (let [example-task-uuid (uuid-generator)
        example-querido-uuid (uuid-generator)]
    {'add
     {:global/config {:config/animated-assets ["penguin.webp"
                                               "fish.webp"
                                               "heart.gif"
                                               "star.gif"
                                               "movies.gif"
                                               "dancing.gif"
                                               "settings-slow.gif"]
                      :config/current-screen :pages
                      :config/user-pub-key pub-key
                      :config/todo-list-order [example-task-uuid :add-task-task]}

      :global/physics {:physics/repulsion-strength 2200.0
                       :physics/repulsion-radius 150.0
                       :physics/damping 4.0
                       :physics/static-friction 300.0
                       :physics/wall-stiffness 200.0
                       :physics/wall-damping 15.0
                       :physics/obstacle-radius 85.0
                       :physics/sleep-speed 4.0
                       :physics/sleep-frames 12
                       :physics/max-speed 3000.0}

      example-task-uuid {:task/title "Example task"
                         :task/completed false
                         :task/subitems []}

      example-querido-uuid (merge {:querido/name "alex computer"
                                   :querido/asset "star.gif"
                                   :querido/pub-key "0299b1e9eee16c522767bc13c3a7247ce52b0113320ee1cb1da7e9eb85a000dc"}
                                  (df/position-attributes :home 130 260))

      :add-task-task {:task/is-add-task? true
                      :task/title ""
                      :task/completed false
                      :task/subitems []}}}))

(defn ^Future get-device-token-future []
  (let [messaging (firebase-messaging/FirebaseMessaging.instance)
        settings (await (.getNotificationSettings messaging))
        status (.-authorizationStatus settings)]
    (when (= status firebase-messaging/AuthorizationStatus.notDetermined)
      (await (.requestPermission messaging
                .alert true
                .sound true
                .badge true
                .provisional true)))
    (when-not (= status firebase-messaging/AuthorizationStatus.denied)
      (-> (.getToken messaging)
          (.then (fn [new-token]
                   new-token))
          (.catchError (fn [e]
                         (prn "Failed to get device token: " e)))))))

(defn ^Future get-secure-credentials []
  (let [storage (FlutterSecureStorage)
        contains-private-key? (await (.containsKey storage .key "private-key"))
        contains-public-key? (await (.containsKey storage .key "public-key"))]
    (cond
      (and contains-private-key? contains-public-key?)
      (let [private-key (await (.read storage .key "private-key"))
            public-key (await (.read storage .key "public-key"))]
        [private-key public-key])

      (and (not contains-private-key?) (not contains-public-key?))
      (let [{:flds [private public]} ^Keychain (.generate Keychain)]
        (await (.write storage .key "private-key" .value private))
        (await (.write storage .key "public-key" .value public))
        [private public])

      :else (throw (Exception "Secure credentials exist partially")))))

(defn main []
  (await (m/WidgetsFlutterBinding.ensureInitialized))
  (await (firebase/Firebase.initializeApp
          .options firebase-options/DefaultFirebaseOptions.currentPlatform))
  (await (haptics/Haptics.canVibrate))
  (services/SystemChrome.setEnabledSystemUIMode services/SystemUiMode.edgeToEdge)
  (f/run
   (m/MaterialApp
    .title "iCare"
    .theme (m/ThemeData
              .colorScheme (m/ColorScheme.light
                            .surface m/Colors.white
                            .background m/Colors.white)
              .textTheme (gf/GoogleFonts.getTextTheme "Dekko")))
   .home
   (m/AnnotatedRegion
    .value (services/SystemUiOverlayStyle
            ;;android settings
            .systemNavigationBarColor m/Colors.transparent
            .systemNavigationBarIconBrightness services/Brightness.dark
            .systemNavigationBarContrastEnforced false
            .statusBarColor m/Colors.transparent
            .statusBarIconBrightness services/Brightness.dark))
   (m/Scaffold
    ;; .backgroundColor (m/Color 0xFFE8F5E9)
    .resizeToAvoidBottomInset false) ;;we handle this manually by scrolling to make our text fields visible
   .body
   (f/widget
    :watch [booted (let [root-token               dart-ui/RootIsolateToken.instance
                         {ports :ports}           (await (isolates/spawn!
                                                          (fn [{:keys [to-storage from-storage]}]
                                                            (services/BackgroundIsolateBinaryMessenger.ensureInitialized ^dart-ui/RootIsolateToken root-token)
                                                            (.listen ^isolate/ReceivePort to-storage
                                                                     (fn [message] (storage/handle-message from-storage message)))
                                                            nil)
                                                          {:ports {:to-storage :send :from-storage :recv}}))
                         responses                (.asBroadcastStream ^isolate/ReceivePort (:from-storage ports))
                         ports*                   (assoc ports :from-storage responses)
                         _                        (.send ^isolate/SendPort (:to-storage ports) [:boot])
                         [_ datafriend-db]        (await (.-first responses))
                         _                        (prn "Datafriend initialized with" (count (get-in datafriend-db [:eav])) "entities")
                         [private-key public-key] (await (get-secure-credentials))
                         _                        (prn "Loaded credentials for pub-key:" public-key)
                         is-empty?                (zero? (count (get-in datafriend-db [:eav])))
                         db                       (if is-empty? (do (prn "Populating default initial data...")
                                                                    (df/transact datafriend-db (default-initial-data public-key)))
                                                                datafriend-db)
                         device-token             (await (get-device-token-future))
                         _                        (prn "Device token:" device-token)
                         _                        (when device-token (df/transact db {'add {:global/config {:config/device-token device-token}}}))
                         conn                     (atom db)
                         ;; re-render after a friend pull updates the db; guarded so
                         ;; an early pull can't fire before the initial build-widgets!
                         rerender!                (fn []
                                                    (prn "rerender! called; widgets-built?=" @ui/widgets-built?)
                                                    (when @ui/widgets-built?
                                                      (prn "rerender! -> calling ui/render-ui!")
                                                      (ui/render-ui! @conn)))
                         _                        (network/watch-friends-loop! conn rerender!)]
                      {:db-conn conn :ports ports* :public-key public-key :private-key private-key})]
    :bypass (when-not booted
              (f/widget
               (m/SafeArea)
               (m/Text "Loading...")))
    :let [{:keys [db-conn ports public-key private-key]} booted
          side-effects {;; every local change transacts and then pushes our namespace
                        ;; up to the server; sync-to-server! is coalesced, so a burst
                        ;; of edits collapses into one trailing sync.
                        :transact!       (fn [diff]
                                           (swap! db-conn df/transact diff)
                                           (network/sync-to-server! db-conn public-key private-key))
                        :render!         (fn [] (ui/render-ui! @db-conn))
                        :persist!        (fn [] (storage/persist-to-disk! ports db-conn))
                        :sync-to-server! (fn [] (network/sync-to-server! db-conn public-key private-key))
                        :make-uuid       uuid-generator}]
    (m/SafeArea ;;we handle the top and bottom manually for edge to edge rendering
     .bottom false
     .top false)
    (ui/build-widgets! @db-conn side-effects))))
