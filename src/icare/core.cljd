(ns icare.core
  (:require ["package:flutter/material.dart" :as m]
            ["package:flutter_secure_storage/flutter_secure_storage.dart" :refer [FlutterSecureStorage]]
            ["package:nostr/nostr.dart" :refer [Keychain]]
            [cljd.flutter :as f]
            [icare.ui.ast :refer [state->ast]]
            [icare.ui.build :refer [ast->widget]]
            [icare.state :refer [initialize-state!]]
            [icare.network :refer [initialize-network!]]))

(defn ^Future get-secure-credentials-future [key-generator]
  (let [storage (FlutterSecureStorage)
        contains-private-key? (await (.containsKey storage .key "private-key"))
        contains-public-key? (await (.containsKey storage .key "public-key"))]
    (cond
      (and contains-private-key? contains-public-key?)
      (let [private-key (await (.read storage .key "private-key"))
            public-key (await (.read storage .key "public-key"))]
        [private-key public-key])

      (and (not contains-private-key?) (not contains-public-key?))
      (let [{:flds [private public]} ^Keychain (key-generator)]
        (await (.write storage .key "private-key" .value private))
        (await (.write storage .key "public-key" .value public))
        [private public])

      :else (throw (Exception. "Secure credentials exist partially")))))

(defn main []
  (f/run
    :let [credentials-future (get-secure-credentials-future (.-generate Keychain))]
    (m/MaterialApp
      .title "iCare")
    .home
    (m/Scaffold)
    .body
    (m/SafeArea)
    (m/FutureBuilder
     .future credentials-future
     .initialData nil
     .builder (fn [_ ^m/AsyncSnapshot snapshot]
                (cond
                  (= m/ConnectionState.done (.-connectionState snapshot))
                  (let [[private-key public-key] (.-data snapshot)
                        store (initialize-state! public-key)]
                    (initialize-network! private-key)
                    (f/widget
                     :watch [state store]
                     (-> state                   ;;state is the end-user representation of the app
                         state->ast              ;;ui is the programmers representation of the app
                         ast->widget)))          ;;widgets are the machine representation of the app

                  :else
                  (m/Text "Loading..."))))))
