(ns icare.core
  (:require ["package:flutter/material.dart" :as m]
            ["package:google_fonts/google_fonts.dart" :as gf]
            ["package:flutter_svg/flutter_svg.dart" :as svg]
            ["package:flutter/services.dart" :as services]
            [cljd.flutter :as f]
            [icare.ui.glue :refer [build-widgets!]]
            [icare.resources.glue :refer [initialize-resources-from-storage!]]
            [icare.network-events :refer [handle-network-data!]]
            [icare.ui-events :refer [handle-ui-event!]]
            [icare.resources.storage :refer [initialize-storage!]]))

(defn main []
  (f/run
    ;;only for older android's this is default on ios and newer androids
    :let [_ (services/SystemChrome.setEnabledSystemUIMode services/SystemUiMode.edgeToEdge)]
    (m/MaterialApp
     .title "iCare"
     .theme (m/ThemeData
               .colorScheme (m/ColorScheme.light
                             .surface m/Colors.white
                             .background m/Colors.white)
               .textTheme (gf/GoogleFonts.getTextTheme "Playwrite GB J")))
    .home
    (m/AnnotatedRegion
     .value (services/SystemUiOverlayStyle
             ;;android settings
             .systemNavigationBarColor m/Colors.transparent
             .systemNavigationBarIconBrightness services/Brightness.dark
             .systemNavigationBarContrastEnforced false
             .statusBarColor m/Colors.transparent
             .statusBarIconBrightness services/Brightness.dark))
    (m/Stack)
    .children
    [(m/Container
      .color (m/Colors.white))
     (f/widget
      (m/Positioned
       .bottom 0)
      (m/Column)
      .children
      [(svg/SvgPicture.asset "assets/grass-pattern.svg"
                             .fit m/BoxFit.fitWidth)
       (svg/SvgPicture.asset "assets/grass-pattern.svg"
                             .fit m/BoxFit.fitWidth)
       (svg/SvgPicture.asset "assets/grass-pattern.svg"
                             .fit m/BoxFit.fitWidth)])
     (f/widget
      (m/Scaffold
       .backgroundColor m/Colors.transparent
       .resizeToAvoidBottomInset false) ;;we handle this manually by scrolling to make our text fields visible
      .body
      (f/widget
       :context ctx
       :watch [storage (initialize-storage!)] ;;storage is a future
       :bypass (when-not storage
                 (f/widget
                  (m/SafeArea)
                  (m/Text "Loading...")))
       :let [[private-key public-key persisted-state] storage
             db (initialize-resources-from-storage! private-key
                                                    public-key
                                                    persisted-state
                                                    handle-network-data!)] ;;i don't like passing handle-network-data! here but it needs to be passed to initialize-network! which is called in initialize-resources! it should probably be passed separately for expliciteness but this is fine for now
       (m/SafeArea ;;we handle the top and bottom manually for edge to edge rendering
        .bottom false
        .top false)
       (build-widgets! db handle-ui-event!)))]))
