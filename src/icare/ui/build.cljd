(ns icare.ui.build
  (:require ["package:flutter/material.dart" :as m]
            ["package:flutter_svg/flutter_svg.dart" :as svg]
            ["package:qr_flutter/qr_flutter.dart" :as qr]
            ["package:share_plus/share_plus.dart" :as share]
            ["package:haptic_feedback/haptic_feedback.dart" :as haptics]
            ["dart:ui" :as ui]
            ["dart:math" :as math]
            [cljd.flutter :as f]))

;;TODO extract common styles to constants
(defn glass-border-painter [r]
  (reify :extends m/CustomPainter
    (paint [_ canvas size]
      (let [hi 0.95
            mid 0.5
            lo 0.25
            stroke 1.35
            half (/ stroke 2.0)
            rect (ui/Rect.fromLTWH half half
                   (- (.-width size) stroke)
                   (- (.-height size) stroke))
            rrect (ui/RRect.fromRectAndRadius rect
                    (ui/Radius.circular (- r half)))
            grad (m/SweepGradient
                  .startAngle 0.0
                  .endAngle (* 2.0 math/pi)
                  .colors [(m/Colors.white.withOpacity lo) (m/Colors.white.withOpacity lo)
                           (m/Colors.white.withOpacity hi) (m/Colors.white.withOpacity hi)
                           (m/Colors.white.withOpacity mid)
                           (m/Colors.white.withOpacity lo) (m/Colors.white.withOpacity lo)
                           (m/Colors.white.withOpacity hi) (m/Colors.white.withOpacity hi)
                           (m/Colors.white.withOpacity mid)
                           (m/Colors.white.withOpacity lo) (m/Colors.white.withOpacity lo)]
                  .stops [0.00 0.02
                          0.035 0.336
                          0.37 0.414
                          0.561 0.585
                          0.811 0.86
                          0.914 1.00])
            p (doto (m/Paint)
                (.-style! ui/PaintingStyle.stroke)
                (.-strokeWidth! stroke)
                (.-strokeJoin! ui/StrokeJoin.round)
                (.-isAntiAlias! true)
                (.-shader! (.createShader grad rect)))]
        (.drawRRect canvas rrect p)))
    (shouldRepaint [_ _] true)))

(defn ast-store->widget
  ([ast-store handle-ui-event!] (ast-store->widget handle-ui-event! ast-store @(get @ast-store "root")))
  ([handle-ui-event! ast-store {:keys [ui-type id] :as ui}]
   (let [recursive-call (fn [ast-id]
                          ;; (prn "ast-store->widget called with ast-id: " ast-id)
                          (ast-store->widget handle-ui-event! ast-store @(get @ast-store ast-id)))
         get-ast-atom (fn [] (get @ast-store id))
         {:keys [key]} @(get-ast-atom)]
     (condp = ui-type
       :root
       (f/widget
        :watch [{:keys [screen]} (get-ast-atom)]
        (recursive-call screen))

       :screen-base
       (f/widget
        (m/Stack
         .children
         [(f/widget
           :let [{:keys [reorderable-list]} @(get-ast-atom)]
           (m/GestureDetector
            .behavior m/HitTestBehavior.opaque
            .onLongPress (fn []
                           (haptics/Haptics.vibrate haptics/HapticsType.heavy)
                           nil))
           (recursive-call reorderable-list))
          (f/widget
           :context ctx
           :let [phone-padding (m/MediaQuery.viewPaddingOf ctx)
                 notch-height (.-top phone-padding)]
           (m/IgnorePointer)
           (m/Column)
           .children
           [(m/Container
             .height (* 1/5 notch-height)
             .color m/Colors.white)
            (m/Container
             .height (* 4/5 notch-height)
             .decoration (m/BoxDecoration
                          .gradient (m/LinearGradient
                                     .begin m/Alignment.topCenter
                                     .end m/Alignment.bottomCenter
                                     .colors [(m/Colors.white.withOpacity 1)
                                              (m/Colors.white.withOpacity 0)])))])]))

       :reorderable-list
       (f/widget
        :context ctx
        :managed [scroll-controller (m/ScrollController)
                  focus-callback (fn []
                                   (when-let [focused (.-primaryFocus m/FocusManager.instance)]
                                     (Future.delayed
                                      (Duration .milliseconds 300)
                                      (fn []
                                        (let [phone-insets (m/MediaQuery.viewInsetsOf ctx)
                                              keyboard-to-bottom (.-bottom phone-insets)
                                              phone-size (m/MediaQuery.sizeOf ctx)
                                              phone-length (.-height phone-size)
                                              focused-to-top (.-dy (.-offset focused))
                                              focused-to-bottom (- phone-length focused-to-top)
                                              extra-height 60
                                              focus-scroll-delta (max
                                                                  0
                                                                  (+ extra-height
                                                                     (- keyboard-to-bottom focused-to-bottom)))
                                              scroll-offset (.-offset scroll-controller)
                                              focus-scroll (+ scroll-offset focus-scroll-delta)]
                                          (.animateTo scroll-controller
                                                      focus-scroll
                                                      .duration (Duration .milliseconds 300)
                                                      .curve m/Curves.linear))))))
                  :dispose nil
                  _ (doto m/FocusManager.instance (.addListener focus-callback))
                  :dispose (.removeListener focus-callback)]
        (m/Scrollbar ;;TODO we should make this default ios style if we're gonna keep bouncy physics for android
         .controller scroll-controller
         .interactive true)
        :watch [{:keys [items]} (get-ast-atom)]
        :let [{:keys [on-reorder friend-search]} @(get-ast-atom)
              phone-padding (m/MediaQuery.viewPaddingOf ctx)
              phone-size (m/MediaQuery.sizeOf ctx)
              phone-height (.-height phone-size)
              notch-height (.-top phone-padding)
              relative-start (/ notch-height phone-height)]
        (m/ReorderableListView
         .anchor relative-start
         ;; .physics (m/BouncingScrollPhysics) ;;TODO this is like ios style for android, i think i prefer it but maybe we should keep the default android physics for android
         .scrollController scroll-controller
         .clipBehavior m/Clip.none
         .padding (m/EdgeInsets.symmetric .horizontal 20)
         .onReorder (on-reorder handle-ui-event!)
         .buildDefaultDragHandles false
         .proxyDecorator (fn [child index animation] child)
         .children (mapv recursive-call items)
         .footer (recursive-call friend-search)))

       :task-card
       (f/widget
        :key key
        :watch [{:keys [expanded? idx title has-alert? tasks]} (get-ast-atom)]
        :vsync clock
        :managed [animation-controller (m/AnimationController
                                         .duration (Duration .milliseconds 500)
                                         .vsync clock)
                  text-controller (m/TextEditingController .text (str title))]
        :let [{:keys [on-expand on-rename-title]} @(get-ast-atom)
              _ (if expanded?
                  (.forward animation-controller)
                  (.reverse animation-controller))
              r 12.0
              glass-border (glass-border-painter r)]
        :padding {:vertical 12}
        (m/CustomPaint .foregroundPainter (when-not has-alert? glass-border))
        (m/Material
         .type m/MaterialType.transparency
         .elevation 0
         .borderRadius (m/BorderRadius.circular 12))
        (m/AnimatedBuilder
         .animation animation-controller
         .builder (fn [ctx child]
                    (m/Container
                     .decoration (m/BoxDecoration
                                  .color (m/Color.lerp (m/Color 0x00FFFFFF) m/Colors.white (.-value animation-controller))
                                  .border (m/Border.all .color (if has-alert?
                                                                 (m/Colors.orange.withOpacity 1)
                                                                 (m/Colors.transparent))
                                                        .width 1)
                                  .borderRadius (m/BorderRadius.circular 12))
                     .child child)))
        (m/Column
         .crossAxisAlignment m/CrossAxisAlignment.start)
        .children
        [;; Header row with tap to expand
         (f/widget
          (m/GestureDetector
           .behavior m/HitTestBehavior.opaque
           .onTap (on-expand handle-ui-event!))
          :padding {:horizontal 16 :vertical 6}
          (m/Row
           .mainAxisAlignment m/MainAxisAlignment.start)
          .children
          [(f/widget
            :watch [text-value text-controller]
            :let [text-style (m/TextStyle
                              .fontSize 22
                              .fontWeight m/FontWeight.normal
                              .color m/Colors.black)
                  current-text (.-text text-value)
                  text-painter (doto (m/TextPainter
                                      .text (m/TextSpan .text current-text .style text-style)
                                      .textDirection ui/TextDirection.ltr)
                                 (.layout))
                  text-width (-> (+ (.-width (.-size text-painter)) 24)
                                 (max 50)
                                 (min 300))]
            (m/SizedBox .width text-width)
            (m/IgnorePointer
             .ignoring (not expanded?))
            (m/TextField
             .readOnly (not expanded?)
             .style text-style
             .onSubmitted (on-rename-title handle-ui-event!)
             .decoration (m/InputDecoration
                          .contentPadding (m/EdgeInsets.only .bottom 0)
                          .border m/InputBorder.none)
             .strutStyle (m/StrutStyle
                          .fontSize 16
                          .height 1.9
                          .forceStrutHeight true)
             .controller text-controller))])
         ;; Expandable content
         (f/widget
          (m/SizeTransition
           .sizeFactor animation-controller
           .axisAlignment -1.0)
          :padding {:left 16 :right 16 :bottom 20}
          (m/Column
           .crossAxisAlignment m/CrossAxisAlignment.start
           .children (mapv recursive-call tasks)))])

       :uninitialized-person-card
       (f/widget
        :key key
        :context ctx
        :watch [{:keys [idx to-title from-title]} (get-ast-atom)]
        :managed [from-text-controller (m/TextEditingController .text from-title)
                  to-text-controller (m/TextEditingController .text to-title)]
        :let [{:keys [on-rename-from on-rename-to on-send-invite on-paste-public-key]} @(get-ast-atom)
              r 12.0
              glass-border (glass-border-painter r)]
        :padding {:vertical 6}
        (m/CustomPaint .foregroundPainter glass-border)
        (m/Material
         .type m/MaterialType.transparency
         .elevation 0
         .borderRadius (m/BorderRadius.circular r))
        (m/ReorderableDelayedDragStartListener
         .index idx)
        :let [phone-width (.-width (m/MediaQuery.sizeOf ctx))
              text-field-width 120
              small-width? (<= phone-width (* 2 text-field-width 1.8)) ;;TODO
              text-field-width (if small-width? 112 text-field-width)
              y-offset -10
              from-text-field (f/widget
                               (m/SizedBox .width text-field-width)
                               (m/TextField
                                .textInputAction m.TextInputAction/done
                                .style (m/TextStyle
                                        .fontSize 16
                                        .fontWeight m/FontWeight.bold
                                        .color m/Colors.black)
                                .onSubmitted (on-rename-from handle-ui-event!)
                                .decoration (m/InputDecoration
                                             .hintText "your name..."
                                             .hintStyle (m/TextStyle .fontSize 16
                                                                     .fontWeight m/FontWeight.bold
                                                                     .color m.Colors/grey)
                                             .contentPadding (m/EdgeInsets.only .bottom y-offset))
                                .strutStyle (m/StrutStyle
                                             .fontSize 16
                                             .height 1.9
                                             .forceStrutHeight true)
                                .controller from-text-controller))
              middle-icon (f/widget
                           :padding {:horizontal 12 :top (+ (- y-offset) 6)}
                           (m/Icon m/Icons.sync_alt_outlined
                                  .size 20
                                  .color (if (empty? from-title)
                                           m/Colors.grey
                                           m/Colors.black)))
              to-text-field (f/widget
                             (m/SizedBox .width text-field-width)
                             (m/TextField
                              .textInputAction m.TextInputAction/done
                              .style (m/TextStyle
                                      .fontSize 16
                                      .fontWeight m/FontWeight.bold
                                      .color m/Colors.black)
                              .onSubmitted (on-rename-to handle-ui-event!)
                              .decoration (m/InputDecoration
                                           .contentPadding (m/EdgeInsets.only .bottom y-offset))
                              .strutStyle (m/StrutStyle
                                           .fontSize 16
                                           .height 1.9
                                           .forceStrutHeight true)
                              .controller to-text-controller))
              send-button (f/widget
                           :padding {:left 4}
                           (m/Transform.translate .offset (m/Offset 0 (- y-offset)))
                           (m/IconButton
                            .iconSize 30
                            .icon (m/Icon m/Icons.send_rounded .color (if (empty? from-title) m/Colors.grey m/Colors.green))
                            .onPressed (when-not (empty? from-title)
                                         (fn []
                                           (-> (.instance share/SharePlus) ;;TODO, this smells like a resource and we should probably treat it as one, for now, this is just for demoing
                                               (.share (share/ShareParams. .text "hi, I'd like to add you as a friend on this social task app:
                                                                         something.com")))
                                           ((on-send-invite handle-ui-event!))))))]

        (m/ListTile
         .tileColor m/Colors.transparent
         .shape (m/RoundedRectangleBorder
                 .borderRadius (m/BorderRadius.circular 12))
         .title (f/widget
                 (m/Transform.translate .offset (m/Offset 0 y-offset))
                 (m/Row)
                 .children
                 [from-text-field
                  (if small-width? send-button middle-icon)
                  to-text-field
                  (m/Spacer)
                  (if small-width? (m/Spacer) send-button)])

         .subtitle (f/widget
                    :let [status-string (cond ;;TODO we can extend this with more statuses like "invite sent, waiting for acceptance", "invite accepted", "invite rejected", etc.
                                          (empty? from-title)
                                          "0. Start out by entering your name. This is how your friend will see you when they accept your invite."
                                          :else "1. Click the send button to share the invite link with your friend.")]
                    (m/Text status-string
                            .style (m/TextStyle
                                    .fontSize 14
                                    .fontWeight m/FontWeight.normal
                                    .color m/Colors.grey)))))

       :editable-task
       (f/widget
        :watch [{:keys [title completed subitems]} (get-ast-atom)]
        :managed [text-controller (m/TextEditingController .text title)]
        :let [{:keys [on-complete on-edit-task-title]} @(get-ast-atom)]
        :padding {:left 20 :bottom 30}
        (m/Column)
        .children
        [(m/Row
          .crossAxisAlignment m.CrossAxisAlignment/center
          .children
          [(f/widget
            :padding {:top 2}
            (m/IconButton
             .icon (m/Icon (if completed
                             m/Icons.check_box
                             m/Icons.check_box_outline_blank)
                           .size 26
                           .color m.Colors/red)
             .onPressed (on-complete handle-ui-event!)))
           (f/widget
            (m/SizedBox .width 160)
            (m/TextField
             .keyboardType m/TextInputType.text
             .autocorrect false
             .maxLines nil
             .style (m/TextStyle
                     .fontSize 22
                     .fontWeight m/FontWeight.normal
                     .color m.Colors/black
                     .decoration (if completed
                                   m.TextDecoration/lineThrough
                                   m.TextDecoration/none))
             .onSubmitted (on-edit-task-title handle-ui-event!)
             .decoration (m/InputDecoration
                          .border m/InputBorder.none)
             .controller text-controller))])
         (f/widget
          :padding {:top 4}
          (m/Column .children (mapv recursive-call subitems)))])

       :add-task-area
       (f/widget
        :let [{:keys [on-add-task]} @(get-ast-atom)
              input-line-offset -4]
        :padding {:left 20}
        (m/Transform.translate .offset (m/Offset 0 input-line-offset))
        (m/Row
         .crossAxisAlignment m.CrossAxisAlignment/center
         .children [(f/widget
                     :padding {:top (+ (- input-line-offset) 2)}
                     (m/IconButton
                      .icon (m/Icon m/Icons.check_box_outline_blank
                                    .size 26
                                    .color m/Colors.grey)
                      .onPressed nil))
                    (f/widget
                     :managed [text-controller (m/TextEditingController)]
                     (m/SizedBox .width 180)
                     (m/TextField
                      .textInputAction m.TextInputAction/done
                      .cursorHeight 38
                      .onSubmitted (fn [new-task-title]
                                     (.clear text-controller)
                                     ((on-add-task handle-ui-event!) new-task-title))
                      .decoration (m/InputDecoration
                                   .hintText "new task..."
                                   .hintStyle (m/TextStyle
                                               .fontSize 22
                                               .fontWeight m/FontWeight.normal
                                               .color m.Colors/grey)
                                   .border m/InputBorder.none
                                   .contentPadding (m/EdgeInsets.only .bottom input-line-offset))
                      .strutStyle (m/StrutStyle
                                   .fontSize 22
                                   .height 1.9
                                   .forceStrutHeight true)
                      .controller text-controller
                      .style (m/TextStyle
                              .fontSize 22
                              .fontWeight m/FontWeight.normal
                              .color m.Colors/black)))]))

       :ronly-task
       (f/widget
        :watch [{:keys [title completed subitems liked notify?]} (get-ast-atom)]
        :let [{:keys [on-liked on-notifies]} @(get-ast-atom)
              animation-duration 2000]
        :padding {:left 20 :bottom 30 :right 20}
        :vsync clock
        :managed [controller (m/AnimationController
                              .vsync clock
                              .duration (Duration .milliseconds animation-duration))]
        :let [color-tween (m/TweenSequence
                           [(m/TweenSequenceItem
                             .weight 30
                             .tween (m/ColorTween
                                     .begin (m/Colors.orange.withOpacity 0)
                                     .end (m/Colors.orange.withOpacity 0)))
                            (m/TweenSequenceItem
                             .weight 20
                             .tween (m/ColorTween
                                     .begin (m/Colors.orange.withOpacity 0)
                                     .end (m/Colors.orange.withOpacity 0.3)))
                            (m/TweenSequenceItem
                             .weight 50
                             .tween (m/ColorTween
                                     .begin (m/Colors.orange.withOpacity 0.3)
                                     .end (m/Colors.orange.withOpacity 0)))])
              animation (.drive controller color-tween)]
        (do
          (when notify?
            (.reset controller)
            (.then (.forward controller) (on-notifies handle-ui-event!)))
          (m/AnimatedBuilder
           .animation animation
           .builder
           (fn [ctx child]
             (f/widget
              (m/Container
               .decoration (m/BoxDecoration
                            .color (.-value animation)
                            .borderRadius (m/BorderRadius.circular 16)))
              (m/Column)
              .children
              [(m/Row
                .crossAxisAlignment m.CrossAxisAlignment/center
                .children
                [(f/widget
                  (m/IconButton
                   .icon (m/Icon (if completed
                                   m/Icons.check_box
                                   m/Icons.check_box_outline_blank)
                                 .size 26
                                 .color m/Colors.grey)
                   .onPressed nil))
                 (f/widget
                  (m/SizedBox .width 160)
                  (m/Text title
                          .maxLines nil
                          .style (m/TextStyle
                                  .fontSize 22
                                  .fontWeight m/FontWeight.normal
                                  .color m/Colors.black
                                  .decoration (if completed
                                                m/TextDecoration.lineThrough
                                                m/TextDecoration.none))))
                 (m/Spacer .flex 2)
                 (f/widget
                  (m/IconButton
                   .icon (m/Icon (if liked
                                   m/Icons.favorite
                                   m/Icons.favorite_border)
                                 .size 26
                                 .color m/Colors.red)
                   .onPressed (on-liked handle-ui-event!)))
                 (m/Spacer .flex 1)])
               (m/Transform.translate
                .offset (m/Offset 0 -2)
                .child (m/Column .children (mapv recursive-call subitems)))])))))

       :subitem-time
       (f/widget
        :watch [{:keys [time]} (get-ast-atom)]
        :let [time (.parse DateTime time)]
        :padding {:left 15 :bottom 4}
        (m/Row
         .children [(f/widget
                     :padding {:bottom 2}
                     (svg/SvgPicture.asset
                      "assets/icons/ph--arrow-bend-down-right-duotone.svg"
                      .colorFilter (m/ColorFilter.mode m/Colors.pink m/BlendMode.srcIn)
                      .width 16
                      .height 16))
                    (m/SizedBox .width 4)
                    (m/Text (str "Completed at " (.-hour time) ":" (.-minute time))
                            .style (m/TextStyle
                                    .fontSize 14
                                    .fontWeight m/FontWeight.normal
                                    .color m.Colors/pink))]))

       :subitem-image
       (f/widget
        :watch [{:keys [url]} (get-ast-atom)]
        :padding {:left 15 :bottom 4}
        (m/Row
         .crossAxisAlignment m.CrossAxisAlignment/start
         .children [(svg/SvgPicture.asset
                     "assets/icons/ph--arrow-bend-down-right-duotone.svg"
                     .colorFilter (m/ColorFilter.mode m/Colors.orange m/BlendMode.srcIn)
                     .width 16
                     .height 16)
                    (m/SizedBox .width 4)
                    (m/Container
                     .width 200
                     .height 120
                     .decoration (m/BoxDecoration
                                  .border (m/Border.all
                                           .color m.Colors/orange
                                           .width 2)
                                  .borderRadius (m/BorderRadius.circular 8)
                                  .image (m/DecorationImage
                                          .fit m.BoxFit/cover
                                          .image (m/NetworkImage url))))]))

       :friend-search-area
       (f/widget
        :key "friend-search-area"
        :let [{:keys [on-search on-handshake-qr on-handshake-network]} @(get-ast-atom)
              r 12.0
              glass-border (glass-border-painter r)]
        :padding {:top 12 :bottom 350}
        (m/CustomPaint .foregroundPainter glass-border)
        (m/Material
         .type m/MaterialType.transparency
         .elevation 0
         .borderRadius (m/BorderRadius.circular r))
        :padding {:horizontal 16 :vertical 6}
        (m/Row
         .mainAxisAlignment m/MainAxisAlignment.start)
        .children
        [(f/widget
          :managed [text-controller (m/TextEditingController)]
          (m/SizedBox .width 120)
          (m/TextField
           .style (m/TextStyle
                   .fontSize 22
                   .fontWeight m/FontWeight.bold
                   .color m.Colors/black)
           .textInputAction m.TextInputAction/done
           .onSubmitted (fn [new-friend-name]
                          (.clear text-controller)
                          ((on-search handle-ui-event!) new-friend-name))
           .decoration (m/InputDecoration
                        .hintText "add friend..."
                        .border m/InputBorder.none
                        .hintStyle (m/TextStyle
                                    .fontSize 22
                                    .fontWeight m/FontWeight.bold
                                    .color m/Colors.grey))
           .strutStyle (m/StrutStyle
                        .fontSize 22
                        .height 1.9
                        .forceStrutHeight true)
           .controller text-controller))
         (m/Spacer)
         (f/widget
          (m/IconButton
           .iconSize 30
           .icon (m/Icon m/Icons.qr_code_scanner_outlined .color m/Colors.green)
           .onPressed (on-handshake-qr handle-ui-event!)))
         (f/widget
          (m/IconButton
           .iconSize 30
           .icon (m/Icon m/Icons.wifi_tethering .color m/Colors.green)
           .onPressed (on-handshake-network handle-ui-event!)))])

       :qr-screen
       (f/widget
        :let [{:keys [on-close user-pub-key]} @(get-ast-atom)]
        (m/Center)
        (m/Column
         .mainAxisAlignment m/MainAxisAlignment.center
         .children [(f/widget
                     (qr/QrImageView
                      .data user-pub-key
                      .version qr/QrVersions.auto
                      .size 300))
                    (f/widget
                     :padding {:top 20 :horizontal 40}
                     (m/Text "Let other people scan and paste this public key to add you as a friend."
                             .textAlign m/TextAlign.center
                             .style (m/TextStyle
                                     .fontSize 16
                                     .fontWeight m/FontWeight.normal
                                     .color m/Colors.black)))
                    (f/widget
                     :padding {:top 20}
                     (m/TextButton
                      .style (m/TextButton.styleFrom
                              .backgroundColor m/Colors.orange
                              .padding (m/EdgeInsets.symmetric
                                        .vertical 12
                                        .horizontal 24)
                              .shape (m/RoundedRectangleBorder
                                      .side (m/BorderSide
                                             .color m/Colors.black
                                             .width 2)
                                      .borderRadius (m/BorderRadius.circular 8)))
                      .onPressed (on-close handle-ui-event!))
                     (m/Text
                      "Close this screen!"
                      .style (m/TextStyle
                              .fontSize 24
                              .fontWeight m/FontWeight.bold
                              .color m/Colors.black)))]))

      (throw (Exception. (str "ast-store->widget tried to render an unknown ui element: " ui)))))))
