(ns icare.ui.build
  (:require ["package:flutter/material.dart" :as m]
            ["package:flutter_svg/flutter_svg.dart" :as svg]
            [cljd.flutter :as f]
            [icare.resources.derived-state :refer [get-pub-key-to-name-map get-pub-key-to-card-controller-map]]
            [cljd.string :as str]))

(defn render-reorderable-list [ui]
  (let [{:keys [on-reorder items]} ui]
    (f/widget
      (m/ReorderableListView
       .padding (m/EdgeInsets.symmetric .horizontal 20)
       .onReorder on-reorder
       .buildDefaultDragHandles false
       .proxyDecorator (fn [child index animation] child)
       .children (mapv ast->widget items)))))

(defn render-task-card [ui]
  (let [{:keys [expanded? on-expand idx title has-alert? on-rename-title key title tasks]} ui
        controller ^m/ExpansibleController ((get-pub-key-to-card-controller-map) key)]
    (if expanded?
      (.expand controller)
      (.collapse controller))
    (f/widget
     :key key
     :padding {:vertical 6}
     (m/Material
      .elevation 0
      .borderRadius (m/BorderRadius.circular 12))
     (m/ExpansionTile
      .controller controller
      .onExpansionChanged on-expand
      .childrenPadding (m/EdgeInsets.only .bottom 20)
      .expandedCrossAxisAlignment m.CrossAxisAlignment/start
      .expandedAlignment m.Alignment/topLeft
      .shape (m/RoundedRectangleBorder
              .side (m/BorderSide
                     .color (m/Colors.green.withOpacity 1))
              .borderRadius (m/BorderRadius.circular 12))
      .collapsedShape (m/RoundedRectangleBorder
                       .side (m/BorderSide
                              .color (if has-alert?
                                       (m/Colors.orange.withOpacity 1)
                                       (m/Colors.black.withOpacity 0.3)))
                              ;; (m/Colors.orange.withOpacity (if has-alert? 1 0)))
                       .borderRadius (m/BorderRadius.circular 12))
      .leading (if expanded?
                 (m/Icon m.Icons/drag_handle .color (m/Colors.black.withOpacity 0.2))
                 (m/ReorderableDragStartListener
                  .index idx
                  .child (m/Icon m.Icons/drag_handle)))
      .title (f/widget
              (m/Align .alignment m/Alignment.centerLeft)
              (m/Row)
              .children
              [
               (f/widget
                (m/SizedBox .width 150)
                (m/TextField
                 .style (m/TextStyle
                          .fontSize 16
                          .fontWeight m/FontWeight.bold
                          .color m/Colors.black)
                 .onSubmitted on-rename-title
                 .decoration (m/InputDecoration
                               .contentPadding (m/EdgeInsets.only .bottom 0)
                               .border m/InputBorder.none)
                 .strutStyle (m/StrutStyle
                               .fontSize 16
                               .height 1.9
                               .forceStrutHeight true)
                 .controller (m/TextEditingController. .text (str title))))])
      .children (mapv ast->widget tasks)))))

(defn render-editable-task [ui]
  (let [{:keys [title on-complete on-edit-task-title completed subitems]} ui]
    (f/widget
     :padding {:left 20 :bottom 30}
     (m/Column)
     .children
     [(m/Row
       .crossAxisAlignment m.CrossAxisAlignment/center
       .children
        [
         (f/widget
          (m/IconButton
           .icon (m/Icon (if completed
                           m/Icons.check_box
                           m/Icons.check_box_outline_blank)
                         .size 26
                         .color m.Colors/red)
           .onPressed on-complete))
         (f/widget
          (m/SizedBox .width 160)
          (m/TextField
           .keyboardType m/TextInputType.text
           .autocorrect false
           .maxLines nil
           .style (m/TextStyle
                           .fontSize 22
                           .fontWeight m.FontWeight/normal
                           .color m.Colors/black
                           .decoration (if completed
                                         m.TextDecoration/lineThrough
                                         m.TextDecoration/none))
           .onSubmitted on-edit-task-title
           .decoration (m/InputDecoration
                         .border m/InputBorder.none)
           .controller (m/TextEditingController. .text title)))])
      (f/widget
       :padding {:top 4}
       (m/Column .children (mapv ast->widget subitems)))])))

(defn render-ronly-task [ui]
  (let [{:keys [title completed subitems liked on-liked notify? on-notifies]} ui
        animation-duration 2000]
    (f/widget  ;;TODO this needs to be its own ast element or a helper function
     :padding {:left 20 :bottom 30 :right 20}
     :vsync clock
     :managed [controller (m/AnimationController
                           .vsync clock
                           .duration (Duration .milliseconds animation-duration))]
     :let [color-tween (m/TweenSequence
                          [(m/TweenSequenceItem
                             .weight 30
                             .tween (m/ColorTween
                                      .begin (m/Colors.orange.withOpacity 0)
                                      .end (m/Colors.orange.withOpacity 0)))
                           (m/TweenSequenceItem
                             .weight 20
                             .tween (m/ColorTween
                                      .begin (m/Colors.orange.withOpacity 0)
                                      .end (m/Colors.orange.withOpacity 0.3)))
                           (m/TweenSequenceItem
                             .weight 50
                             .tween (m/ColorTween
                                     .begin (m/Colors.orange.withOpacity 0.3)
                                     .end (m/Colors.orange.withOpacity 0)))])
           animation (.drive controller color-tween)]
     (do
       (when notify?
         (.reset controller)
         (.then (.forward controller) on-notifies))
       (m/AnimatedBuilder
        .animation animation
        .builder
        (fn [ctx child]
          (f/widget
           (m/Container
            .decoration (m/BoxDecoration
                         .color (.-value animation)
                         .borderRadius (m/BorderRadius.circular 16)))
           (m/Column)
           .children
           [(m/Row
             .crossAxisAlignment m.CrossAxisAlignment/center
             .children
              [(f/widget
                (m/IconButton
                 .icon (m/Icon (if completed
                                 m/Icons.check_box
                                 m/Icons.check_box_outline_blank)
                               .size 26
                               .color m/Colors.grey)
                 .onPressed nil))
               (f/widget
                (m/SizedBox .width 160)
                (m/Text title
                        .maxLines nil
                        .style (m/TextStyle
                                 .fontSize 22
                                 .fontWeight m/FontWeight.normal
                                 .color m/Colors.black
                                 .decoration (if completed
                                               m/TextDecoration.lineThrough
                                               m/TextDecoration.none))))
               (m/Spacer .flex 2)
               (f/widget
                (m/IconButton
                 .icon (m/Icon (if liked
                                 m/Icons.favorite
                                 m/Icons.favorite_border)
                               .size 26
                               .color m/Colors.red)
                 .onPressed on-liked))
               (m/Spacer .flex 1)])
            (m/Transform.translate
             .offset (m/Offset 0 -2)
             .child (m/Column .children (mapv ast->widget subitems)))])))))))

(defn render-subitem-liked-list [ui]
  (let [{:keys [liked-by]} ui]
    (f/widget
     :padding {:left 15 :bottom 4}
     :let [liked-by (mapv (get-pub-key-to-name-map) liked-by)]
     (m/Row
      .children [(svg/SvgPicture.asset
                  "assets/icons/ph--arrow-bend-down-right-duotone.svg"
                  .colorFilter (m/ColorFilter.mode m/Colors.red m/BlendMode.srcIn)
                  .width 16
                  .height 16)
                 (m/SizedBox .width 4)
                 (m/Text (cond
                           (= 1 (count liked-by))
                           (str "Loved by " (first liked-by))

                           (= 2 (count liked-by))
                           (str "Loved by " (str/join " and " liked-by))

                           :else (str "Loved by " (str/join ", " (butlast liked-by))
                                      ", and " (last liked-by)))
                    .style (m/TextStyle
                             .fontSize 14
                             .fontWeight m.FontWeight/normal
                             .color m.Colors/red))]))))

(defn render-subitem-time [ui]
  (let [{:keys [time]} ui
        time (.parse DateTime time)]
    (f/widget
     :padding {:left 15 :bottom 4}
     (m/Row
      .children [
                 (f/widget
                  :padding {:bottom 2}
                  (svg/SvgPicture.asset
                   "assets/icons/ph--arrow-bend-down-right-duotone.svg"
                   .colorFilter (m/ColorFilter.mode m/Colors.pink m/BlendMode.srcIn)
                   .width 16
                   .height 16))
                 (m/SizedBox .width 4)
                 (m/Text (str "Completed at " (.-hour time)":"(.-minute time))
                         .style (m/TextStyle
                                  .fontSize 14
                                  .fontWeight m.FontWeight/normal
                                  .color m.Colors/pink))]))))

(defn render-subitem-image [ui]
  (let [{:keys [url]} ui]
    (f/widget
     :padding {:left 15 :bottom 4}
     (m/Row
      .crossAxisAlignment m.CrossAxisAlignment/start
      .children [(svg/SvgPicture.asset
                  "assets/icons/ph--arrow-bend-down-right-duotone.svg"
                  .colorFilter (m/ColorFilter.mode m/Colors.orange m/BlendMode.srcIn)
                  .width 16
                  .height 16)
                 (m/SizedBox .width 4)
                 (m/Container
                  .width 200
                  .height 120
                  .decoration (m/BoxDecoration
                                .border (m/Border.all
                                          .color m.Colors/orange
                                          .width 2)
                                .borderRadius (m/BorderRadius.circular 8)
                                .image (m/DecorationImage
                                         .fit m.BoxFit/cover
                                         .image (m/NetworkImage url))))]))))

(defn render-friend-search-area [ui]
  (let [{:keys [on-search]} ui]
    (f/widget
     :key "friend-search-area"
     :padding {:left 15 :bottom 15}
     (m/Row
      .children [(f/widget
                  :padding {:right 20 :top 4}
                  (m/Icon m.Icons/person_add
                          .size 22
                          .color m.Colors/black))
                 (f/widget
                  :let [text-controller (m/TextEditingController.)]
                  (m/SizedBox .width 180)
                  (m/TextField
                   .textInputAction m.TextInputAction/done
                   .cursorHeight 38
                   .onSubmitted (fn [& args]
                                  (.clear text-controller)
                                  (apply on-search args))
                   .decoration (m/InputDecoration
                                 .hintText "new friend..."
                                 .hintStyle (m/TextStyle
                                              .fontSize 22
                                              .fontWeight m.FontWeight/normal
                                              .color m.Colors/grey)
                                 .contentPadding (m/EdgeInsets.only .bottom 0))
                   .strutStyle (m/StrutStyle
                                 .fontSize 22
                                 .height 1.9
                                 .forceStrutHeight true)
                   .controller text-controller
                   .style (m/TextStyle
                            .fontSize 22
                            .fontWeight m.FontWeight/normal
                            .color m.Colors/black)))]))))

(defn render-add-task-area [ui]
  (let [{:keys [on-add-task]} ui]
    (f/widget
     :padding {:left 20}
     (m/Row
      .crossAxisAlignment m.CrossAxisAlignment/center
      .children [(f/widget
                  :padding {:top 8}
                  (m/IconButton
                   .icon (m/Icon m/Icons.add
                                 .size 26
                                 .color m.Colors/red)
                   .onPressed nil))
                 (f/widget
                  :let [text-controller (m/TextEditingController.)]
                  (m/SizedBox .width 180)
                  (m/TextField
                   .textInputAction m.TextInputAction/done
                   .cursorHeight 38
                   .onSubmitted (fn [& args]
                                   (.clear text-controller)
                                   (apply on-add-task args))
                   .decoration (m/InputDecoration
                                 .hintText "new task..."
                                 .hintStyle (m/TextStyle
                                              .fontSize 22
                                              .fontWeight m.FontWeight/normal
                                              .color m.Colors/grey)
                                 .contentPadding (m/EdgeInsets.only .bottom 0))
                   .strutStyle (m/StrutStyle
                                 .fontSize 22
                                 .height 1.9
                                 .forceStrutHeight true)
                   .controller text-controller
                   .style (m/TextStyle
                            .fontSize 22
                            .fontWeight m.FontWeight/normal
                            .color m.Colors/black)))]))))

(defn render-screen-base [ui]
  (let [{:keys [reorderable-list]} ui]
    (f/widget
     m/Stack
     .children
     [(ast->widget reorderable-list)])))

(defn ast->widget [ui]
  (let [{:keys [ui-type]} ui]
   (condp = ui-type
     :screen-base                    (render-screen-base ui)
     :reorderable-list               (render-reorderable-list ui)
     :task-card                      (render-task-card ui)
     :ronly-task                     (render-ronly-task ui)
     :editable-task                  (render-editable-task ui)
     :subitem-liked-list             (render-subitem-liked-list ui)
     :subitem-time                   (render-subitem-time ui)
     :subitem-image                  (render-subitem-image ui)
     :friend-search-area             (render-friend-search-area ui)
     :add-task-area                  (render-add-task-area ui)
     (throw (Exception. (str "ast->widget tried to render an unknonw ui element: " ui))))))
