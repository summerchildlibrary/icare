(ns icare.ui.ast
  (:require ["package:flutter/material.dart" :as m]
            ["package:uuid/uuid.dart" :refer [Uuid]]
            [icare.state :refer [dispatch!] :rename {dispatch! state-dispatch!}]
            [icare.network :refer [dispatch!] :rename {dispatch! network-dispatch!}]))

(def uuid-generator (.-v4 (Uuid)))
;;Build an AST from our state

(defn task-subitems->ast [subitem]
  (let [{:keys [type value]} subitem]
    (cond
      (= type :liked-list) {:ui-type :subitem-liked-list :liked-by value}
      (= type :time) {:ui-type :subitem-time :time value}
      (= type :image) {:ui-type :subitem-image :url value}
      :else (throw (Exception. (str "task-subitems->ast was given a task subitem with unknown type: " type))))))

(defn user-task->ast [task-idx task]
  (let [{:keys [title completed subitems reorderable-item-idx]} task]
    {:ui-type :editable-task
     :title title
     :on-complete (fn []
                    (state-dispatch! {:type :complete-user-task
                                      :user-card-idx reorderable-item-idx
                                      :task-idx task-idx
                                      :completed (not completed)}))
     :on-edit-task-title (fn [title]
                           (if (empty? title)
                             (state-dispatch! {:type :delete-user-task
                                               :user-card-idx reorderable-item-idx
                                               :task-idx task-idx})
                             (state-dispatch! {:type :rename-user-task
                                               :user-card-idx reorderable-item-idx
                                               :task-idx task-idx
                                               :title title})))
     :completed completed
     :subitems (mapv task-subitems->ast subitems)}))

(defn friend-task->ast [task-idx task]
  (let [{:keys [title completed liked subitems reorderable-item-idx creator-pub-key uuid]} task]
    {:ui-type :ronly-task
     :title title
     :completed completed
     :on-liked (fn []
                 (network-dispatch! {:type :send-liked-event
                                     :liked (not liked)
                                     :creator-pub-key creator-pub-key
                                     :task-uuid uuid})
                 (state-dispatch! {:type :like-friend-task
                                   :friend-card-idx reorderable-item-idx
                                   :task-idx task-idx
                                   :liked (not liked)}))
     :liked liked
     :subitems (mapv task-subitems->ast subitems)}))

(defn add-tasks->ast [reorderable-item-idx]
  {:ui-type :add-task-area
   :on-add-task (fn [value]
                  (when (not (empty? value))
                    (let [new-task {:title value
                                    :uuid (uuid-generator)
                                    :completed false
                                    :subitems []}]
                      (network-dispatch! {:type :send-update-task-event
                                          :task new-task
                                          :task-uuid (:uuid new-task)})
                      (state-dispatch! {:type :add-user-task
                                        :user-card-idx reorderable-item-idx
                                        :new-task new-task}))))})

(defn person->ast [reorderable-item-idx person]
  (let [{:keys [user? name tasks pub-key]} person
        tasks (mapv #(conj % {:reorderable-item-idx reorderable-item-idx :creator-pub-key pub-key}) tasks)]
    {:ui-type :task-card
     :initially-expanded user?
     :add-tasks? user?
     :key pub-key
     :title name
     :on-rename-title (fn [value]
                        (if (empty? value)
                          (state-dispatch! {:type :delete-card
                                            :card-idx reorderable-item-idx})
                          (state-dispatch! {:type :rename-card
                                            :card-idx reorderable-item-idx
                                            :name value})))
     :tasks (if user?
              (conj (mapv user-task->ast (range) tasks) (add-tasks->ast reorderable-item-idx))
              (mapv friend-task->ast (range) tasks))}))

(defn friend-search->ast []
  {:ui-type :friend-search-area
   :on-search (fn [value]
                (state-dispatch! {:type :add-friend
                                  :pub-key value}))})

(defn list-item->ast [reorderable-item-idx item]
  (let [{:keys [type]} item]
    (cond
      (= type :user) (person->ast reorderable-item-idx (conj item {:user? true}))
      (= type :friend) (person->ast reorderable-item-idx (conj item {:user? false}))
      (= type :friend-search) (friend-search->ast)
      :else (throw (Exception. (str "list-item->ast was given a list item with unknown type: " type))))))

(defn reorderable-list->ast [reorderable-items]
  {:ui-type :reorderable-list
   :on-reorder (fn [from-index to-index]
                 (let [[from-index to-index] (if (< from-index to-index)
                                               [from-index (dec to-index)]
                                               [from-index to-index])]
                   (state-dispatch! {:type :reorder-items
                                     :from-index from-index
                                     :to-index to-index})))
   :items (mapv list-item->ast (range) reorderable-items)})

(defn undo-redo->ast [undo-redo]
  (let [{:keys [x y]} undo-redo]
    {:ui-type :undo-redo-area
     :x x
     :y y
     :on-move (fn [^m/DragUpdateDetails details]
                (let [new-position (.-delta details)
                      {:flds [dx dy]} new-position]
                  (state-dispatch! {:type :move-undo-redo
                                    :dx dx
                                    :dy dy})))
     :on-undo identity
     :on-redo identity}))

(defn state->ast [state]
  (let [{:keys [undo-redo reorderable-items]} state]
    {:ui-type :screen-base
     :undo-redo (undo-redo->ast undo-redo) ;
     :reorderable-list (reorderable-list->ast reorderable-items)}))
