(ns icare.ui-events
  (:require [icare.resources.network :refer [dispatch!] :rename {dispatch! network-dispatch!}]
            [icare.resources.storage :refer [dispatch!] :rename {dispatch! storage-dispatch!}]
            [icare.resources.derived-state
             :refer [dispatch! get-derived-state get-user-pub-key]
             :rename {dispatch! derived-state-dispatch!}]
            [icare.resources.state
             :refer [dispatch! get-people-cards get-task-by-indexes gather-pub-keys-and-uuids get-task-by-indexes]
             :rename {dispatch! state-dispatch!}]
            [icare.resources.glue :refer [update-state-and-persist!]]
            [icare.ui.glue :refer [render-ui!]]))

;;UI event handler for events triggered by user interactions.
;;Coordinates state updates, storage persistence, and outbound network messages.
;;UI event callbacks are defined in ast.cljd and passed to widgets in build.cljd.
;;
(defn update-state-render-and-persist! [event derive-state?]
  (let [new-state (update-state-and-persist! event)
        new-derived-state (if derive-state?
                            (derived-state-dispatch! {:type :derive-state
                                                      :people-cards (get-people-cards new-state)})
                            (get-derived-state))]
    (render-ui! [new-derived-state new-state])
    [new-derived-state new-state]))

(defn handle-ui-event! [event]
  (let [{:keys [type]} event]
    (condp = type
      :complete-user-task
     (let [[derived-state state] (update-state-render-and-persist! event false)
           updated-task (get-task-by-indexes state (:user-card-idx event) (:task-idx event))]
       (network-dispatch! {:type :send-updated-task
                           :deleted false
                           :task updated-task}))

     :delete-user-task
     (do
       (update-state-render-and-persist! event false)
       (network-dispatch! {:type :send-updated-task
                           :deleted true
                           :task (:task event)}))

     :rename-user-task
     (let [[derived-state state] (update-state-render-and-persist! event false)
           updated-task (get-task-by-indexes state (:user-card-idx event) (:task-idx event))]
       (network-dispatch! {:type :send-updated-task
                           :deleted false
                           :task updated-task}))

     :like-friend-task
     (do
       (update-state-render-and-persist! event false)
       (network-dispatch! {:type :update-request-to-notify
                           :want-notifications? (:want-notifications? event)
                           :to-pub-key (:creator-pub-key event)
                           :task-uuid (:task-uuid event)}))

     :add-user-task
     (let [[derived-state state] (update-state-render-and-persist! event false)
           new-task (get-task-by-indexes state (:user-card-idx event) (:task-idx event))
           {:keys [user-task-uuids friend-pub-keys]} (gather-pub-keys-and-uuids state)
           user-pub-key (get-user-pub-key derived-state)]
       (network-dispatch! {:type :send-updated-task
                           :deleted false
                           :task new-task})
       (network-dispatch! {:type :update-notify-requests-subscription
                           :user-pub-key user-pub-key
                           :user-task-uuids user-task-uuids
                           :friend-pub-keys friend-pub-keys}))

     :delete-card
     (let [[derived-state state] (update-state-render-and-persist! event true)
           {:keys [user-task-uuids friend-pub-keys]} (gather-pub-keys-and-uuids state)
           user-pub-key (get-user-pub-key derived-state)]
       (network-dispatch! {:type :update-friend-tasks-subscription
                           :friend-pub-keys friend-pub-keys})
       (network-dispatch! {:type :update-notify-requests-subscription
                           :user-pub-key user-pub-key
                           :user-task-uuids user-task-uuids
                           :friend-pub-keys friend-pub-keys}))

     :add-friend
     (update-state-render-and-persist! event false)

     :initialize-friend
     (let [[derived-state state] (update-state-render-and-persist! event true)
           {:keys [user-task-uuids friend-pub-keys]} (gather-pub-keys-and-uuids state)
           user-pub-key (get-user-pub-key derived-state)]
       (network-dispatch! {:type :update-friend-tasks-subscription
                           :friend-pub-keys friend-pub-keys})
       (network-dispatch! {:type :update-notify-requests-subscription
                           :user-pub-key user-pub-key
                           :user-task-uuids user-task-uuids
                           :friend-pub-keys friend-pub-keys}))

     :delete-uninitialized-card
     (update-state-render-and-persist! event false)

     :rename-uninitialized-card-friend
     (update-state-render-and-persist! event false)

     :rename-uninitialized-card-self
     (update-state-render-and-persist! event false)

     :rename-card
     (update-state-render-and-persist! event true)

     :task-notification-finishes
     (update-state-render-and-persist! event false)

     :card-expansion
     (update-state-render-and-persist! event false)

     :reorder-items
     (update-state-render-and-persist! event false)

     :send-friend-request
     (update-state-render-and-persist! event false)

     :toggle-handshake-qr ;;just showing a qr code, no need to persist state
     (-> [(get-derived-state) (state-dispatch! event)]
         (render-ui!))

     :toggle-handshake-network
     (-> [(get-derived-state) (state-dispatch! event)]
         (render-ui!))

     (throw (Exception (str "Unknown event type in ui-events dispatch: " event))))))
