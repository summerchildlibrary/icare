(ns icare.ui-events
  (:require [icare.resources.network :refer [dispatch!] :rename {dispatch! network-dispatch!}]
            [icare.resources.storage :refer [dispatch!] :rename {dispatch! storage-dispatch!}]
            [icare.resources.derived-state :refer [dispatch!] :rename {dispatch! derived-state-dispatch!}]
            [icare.resources.state
             :refer [dispatch! get-people-cards get-task-by-indexes gather-pub-keys-and-uuids get-user-pub-key]
             :rename {dispatch! state-dispatch!}]
            [icare.resources.utils :refer [update-state-and-persist!]]))

;;UI event handler for events triggered by user interactions.
;;Coordinates state updates, storage persistence, and outbound network messages.
;;UI event callbacks are defined in ast.cljd and passed to widgets in build.cljd.

(defn handle-ui-event! [event]
  (let [{:keys [type]} event]
    (condp = type
      :complete-user-task
     (let [new-state (update-state-and-persist! event)
           updated-task (get-task-by-indexes new-state (:user-card-idx event) (:task-idx event))]
       (network-dispatch! {:type :update-task-event
                           :deleted false
                           :task updated-task}))

     :delete-user-task
     (do
       (update-state-and-persist! event)
       (network-dispatch! {:type :update-task-event
                           :deleted true
                           :task (:task event)}))

     :rename-user-task
     (let [new-state (update-state-and-persist! event)
           updated-task (get-task-by-indexes new-state (:user-card-idx event) (:task-idx event))]
       (network-dispatch! {:type :update-task-event
                           :deleted false
                           :task updated-task}))

     :like-friend-task
     (do
       (update-state-and-persist! event)
       (network-dispatch! {:type :liked-event
                           :liked (:liked event)
                           :creator-pub-key (:creator-pub-key event)
                           :task-uuid (:task-uuid event)}))

     :add-user-task
     (let [new-state (update-state-and-persist! event)
           {:keys [user-task-uuids friend-pub-keys]} (gather-pub-keys-and-uuids new-state)
           user-pub-key (get-user-pub-key new-state)]
       (network-dispatch! {:type :update-task-event
                           :deleted false
                           :task (:new-task event)})
       (network-dispatch! {:type :reactions-request
                           :user-pub-key user-pub-key
                           :user-task-uuids user-task-uuids
                           :friend-pub-keys friend-pub-keys}))

     :delete-card
     (let [new-state (update-state-and-persist! event)
           {:keys [user-task-uuids friend-pub-keys]} (gather-pub-keys-and-uuids new-state)
           user-pub-key (get-user-pub-key new-state)
           people-cards (get-people-cards new-state)]
       (derived-state-dispatch! {:type :derive-state
                                 :people-cards people-cards})
       (network-dispatch! {:type :tasks-request
                           :friend-pub-keys friend-pub-keys})
       (network-dispatch! {:type :reactions-request
                           :user-pub-key user-pub-key
                           :user-task-uuids user-task-uuids
                           :friend-pub-keys friend-pub-keys}))

     :add-friend
     (let [new-state (update-state-and-persist! event)
           {:keys [user-task-uuids friend-pub-keys]} (gather-pub-keys-and-uuids new-state)
           user-pub-key (get-user-pub-key new-state)
           people-cards (get-people-cards new-state)]
       (derived-state-dispatch! {:type :derive-state
                                 :people-cards people-cards})
       (network-dispatch! {:type :tasks-request
                           :friend-pub-keys friend-pub-keys})
       (network-dispatch! {:type :reactions-request
                           :user-pub-key user-pub-key
                           :user-task-uuids user-task-uuids
                           :friend-pub-keys friend-pub-keys}))

     :rename-card
     (let [new-state (update-state-and-persist! event)
           people-cards (get-people-cards new-state)]
       (derived-state-dispatch! {:type :derive-state
                                 :people-cards people-cards}))

     :task-notification-finishes
     (update-state-and-persist! event)

     :card-expansion
     (update-state-and-persist! event)

     :reorder-items
     (update-state-and-persist! event)

     :transform-magic-button
     (update-state-and-persist! event)

     (throw (Exception (str "Unknown event type in ui-events dispatch: " event))))))
