(ns icare.resources.glue
  (:require [icare.resources.state
             :refer [dispatch! initialize-state! gather-pub-keys-and-uuids get-device-token get-network-log]
             :rename {dispatch! state-dispatch!}]
            [icare.resources.storage :refer [initialize-storage! dispatch!] :rename {dispatch! storage-dispatch!}]
            [icare.resources.network :refer [initialize-network! dispatch!] :rename {dispatch! network-dispatch!}]
            ["package:firebase_messaging/firebase_messaging.dart" :as firebase-messaging]))

(defn update-state-and-persist! [event]
  (let [db (state-dispatch! event)]
    (storage-dispatch! {:type :state-change-event :new-state (:state db)})
    db))

(defn ^Future get-device-token-future []
  (let [messaging (firebase-messaging/FirebaseMessaging.instance)
        settings (await (.getNotificationSettings messaging))
        status (.-authorizationStatus settings)]
    ;;TODO this is a good place to set the listener for token changes
    (when (= status firebase-messaging/AuthorizationStatus.notDetermined)
      (await (.requestPermission messaging
                .alert true
                .sound true
                .badge true
                .provisional true)))
    (when-not (= status firebase-messaging/AuthorizationStatus.denied)
      (-> (.getToken messaging)
          (.then (fn [new-token]
                   new-token))
          (.catchError (fn [e]
                         (prn "Failed to get device token: " e)))))))

(defn ^Future initialize-resources-from-storage! [private-key public-key persisted-state persisted-receipts persisted-network-log handle-network-data!]
  (let [store (initialize-state! public-key persisted-state persisted-receipts persisted-network-log)
        db @store
        old-device-token (get-device-token {:state db});;TODO we can get rid of this once we implement the glue function
        new-device-token (await (get-device-token-future))
        ;;TODO a good way to manage these new tokens is with some function in glue that updates state, persits, and checks for differences with the old token and sends the appropriate network calls
        db (if (not= old-device-token new-device-token) ;;TODO when the device token changes, we need to send a bunch of updated notify request calls. We need to figure out how to handle network reconnection, probably we can have a network event that gets called on both on initial connection and reconnection to the ws, there is where we can grab the latest device token and send the updated notify requests and updated task calls. It might not even be neccessary to store the device token since we plan on resending all our state on every reconnection, if we try and be smart about it we might need to create some sort of queue for failed network calls that we resend on device connection. Then, we wouldn't even have to worry about at what point in the app cycle we send out the update notify requestsif we try and be smart about it we might need to create some sort of queue for failed network calls that we resend on device connection. Then, we wouldn't even have to worry about at what point in the app cycle we send out the update notify requests.
             (update-state-and-persist! {:type :update-device-token :device-token new-device-token})
             db)
        {:keys [user-task-uuids friend-pub-keys]} (gather-pub-keys-and-uuids (:state db))]
    (initialize-network! private-key user-task-uuids friend-pub-keys public-key handle-network-data!)
    db))

(defn ^Future initialize-resources! [handle-network-data!]
  (let [[private-key public-key persisted-state persisted-receipts persisted-network-log] (await (initialize-storage!))]
    (initialize-resources-from-storage! private-key public-key persisted-state persisted-receipts persisted-network-log handle-network-data!)))

(defn attemp-network-update! [event]
  (let [log (conj (get-network-log) event)]
    (loop [event (first log) log (next log)]
      (if event
        (if (network-dispatch! event)
          (recur (first log) (next log))
          (let [db (state-dispatch! {:type :reset-network-log :log (apply vector event log)})]
            (storage-dispatch! {:type :network-log-change-event :new-network-log (:network-log db)})))
        (let [db (state-dispatch! {:type :reset-network-log :log []})]
          (storage-dispatch! {:type :network-log-change-event :new-network-log (:network-log db)}))))))
