(ns icare.network
  "REST sync client for the datamigo server. Drives the negentropy protocol over
   HTTP: the client is always the initiator.

   Push (own namespace): sync rounds against /sync compute the diff the server must
   apply; the client signs it and POSTs /commit. Pull (a friend's namespace): the
   same sync rounds, but the client applies the resulting diff to its own copy and
   never commits. Watch: long-poll /watch to be told when a friend committed, then
   pull-sync that friend."
  (:require ["dart:io" :as io]
            ["dart:convert" :as convert]
            ["package:crypto/crypto.dart" :as crypto]
            ["package:convert/convert.dart" :as dartconvert]
            ["package:nostr/nostr.dart" :refer [Keychain]]
            [cljd.edn :as edn]
            [icare.aztree :as aztree]
            [icare.datafriend :as df]
            [icare.negentropy :as negentropy]))

(def server-url "http://localhost:8080") ;; TODO configurable / https in production

(defonce ^:private http-client (io/HttpClient))

(defn- sha256-hex
  "SHA-256 of the UTF-8 bytes of `s`, hex-encoded — the 32-byte-hash-as-hex form
   bip340/Keychain.sign expects and the server's verifySchnorr checks."
  [^String s]
  (dartconvert/hex.encode (.-bytes (.convert crypto/sha256 (convert/utf8.encode s)))))

;; ── HTTP ──────────────────────────────────────────────────────────────────────

(defn ^Future post-edn
  "POST an EDN body to `path` and return the parsed EDN response."
  [path body]
  (let [uri (Uri/parse (str server-url path))
        request (await (.postUrl ^io/HttpClient http-client uri))]
    (.write request (pr-str body))
    (let [response (await (.close request))
          text (await (.join (.transform response convert/utf8.decoder)))]
      (edn/read-string text))))

;; ── Sync rounds ───────────────────────────────────────────────────────────────

(defn ^Future run-sync-rounds
  "Drive the negentropy rounds against the server for `namespace`, with `tree` as
   the initiator's view. Returns {:only-ours [[k v]...] :only-theirs [[k v]...]
   :commit-token t}: only-ours are entries the client has that the server lacks,
   only-theirs the reverse. Callers pick direction (push vs pull)."
  [namespace tree]
  (loop [ranges (negentropy/initial-ranges tree)
         only-ours []
         only-theirs []
         commit-token nil
         rounds 0]
    (if (or (empty? ranges) (> rounds 64))
      {:only-ours only-ours :only-theirs only-theirs :commit-token commit-token}
      (let [response (await (post-edn "/sync" {:namespace namespace :ranges ranges}))
            {:keys [sub-ranges]} response
            token (:commit-token response)
            {next-ranges :next-ranges new-ours :only-ours new-theirs :only-theirs}
            (negentropy/process-response tree sub-ranges)]
        (recur next-ranges (into only-ours new-ours) (into only-theirs new-theirs) token (inc rounds))))))

;; ── Push (own namespace) ──────────────────────────────────────────────────────

(defn ^Future push-sync!
  "Sync the owner's namespace `tree` up to the server. Runs the negentropy rounds,
   signs the resulting diff and commit token with `private-key-hex`, and commits.
   `public-key-hex` is the namespace. Returns the server's commit response."
  [public-key-hex private-key-hex tree]
  (let [{:keys [only-ours only-theirs commit-token]} (await (run-sync-rounds public-key-hex tree))
        ;; the server must converge to the client: put what the client has and the
        ;; server lacks, delete what the server has and the client lacks.
        diff {:puts only-ours :deletes (mapv first only-theirs)}]
    (if (and (empty? (:puts diff)) (empty? (:deletes diff)))
      {:ok true :noop true} ;; already in sync, nothing to commit
      (let [message-hash-hex (sha256-hex (pr-str [public-key-hex diff commit-token]))
            signature (.sign (Keychain private-key-hex) message-hash-hex)]
        (await (post-edn "/commit" {:namespace public-key-hex
                                    :diff diff
                                    :commit-token commit-token
                                    :signature signature}))))))

;; Coalescing state for sync-to-server!, independent of the local :persist! sync.
;; While a server sync runs, further calls only mark that another is needed, so
;; exactly one trailing run fires afterward against the latest db snapshot.
(defonce ^:private syncing? (atom false))
(defonce ^:private pending? (atom false))

(defn- drive-server-sync! [db-conn public-key-hex private-key-hex]
  (reset! pending? false)
  ;; snapshot :ordered now; the aztree is immutable so the sync runs against a
  ;; stable point-in-time even as the user keeps transacting.
  (-> (push-sync! public-key-hex private-key-hex (:ordered @db-conn))
      (.then (fn [_]
               (if @pending?
                 (drive-server-sync! db-conn public-key-hex private-key-hex)
                 (reset! syncing? false))))
      (.catchError (fn [e]
                     (reset! syncing? false)
                     (prn "sync-to-server! failed:" e)))))

(defn sync-to-server!
  "Push our namespace up to the server, coalesced: while a sync runs, further calls
   only mark that another is needed, so exactly one trailing run fires afterward
   against the latest db. Each run snapshots :ordered and signs the commit with the
   private key."
  [db-conn public-key-hex private-key-hex]
  (if @syncing?
    (reset! pending? true)
    (do (reset! syncing? true) (drive-server-sync! db-conn public-key-hex private-key-hex)))
  nil)

;; ── Pull (a friend's namespace) ───────────────────────────────────────────────

(defn ^Future pull-sync!
  "Sync a friend's namespace down. `local-ordered` is the friend db's current
   :ordered aztree; runs the negentropy rounds against it and returns the diff to
   apply to that db: {:puts [[key value]...] :delete-keys [key...]}. Puts are
   entries the server has and we lack (with values); delete-keys are entries we
   have and the server no longer does. Apply with datafriend/apply-records, which
   preserves the server's timestamps so later pulls stay incremental. Read-only on
   the server."
  [friend-public-key-hex local-ordered]
  (let [{:keys [only-ours only-theirs]} (await (run-sync-rounds friend-public-key-hex local-ordered))]
    {:puts only-theirs :delete-keys (mapv first only-ours)}))

;; ── Watch (long-poll) ─────────────────────────────────────────────────────────

(defn ^Future watch-once!
  "Long-poll the server for a change to any of `friend-public-key-hexes`. Blocks up
   to the server's timeout (~1 min) and returns the namespace hex that changed, or
   nil on timeout. Callers loop this, pull-syncing the poked friend each time."
  [friend-public-key-hexes]
  (let [response (await (post-edn "/watch" {:namespaces friend-public-key-hexes}))]
    (:poked response)))

;; ── Friend pull loop ──────────────────────────────────────────────────────────
;;
;; Friends' data is kept in the db-conn map keyed by their pubkey-hex, each a full
;; datafriend db queryable just like our own. On app open we pull each friend once,
;; then long-poll: whenever a friend commits, the server pokes us and we pull just
;; that friend's changes. Friend dbs are not persisted — each app open starts them
;; empty and the first pull fetches everything.

(defn ^Future pull-friend!
  "Pull one friend's latest changes into db-conn under their pubkey-hex. Runs the
   negentropy rounds against our current copy of the friend's db and applies the
   resulting diff, preserving the server's timestamps so the next pull is
   incremental."
  [db-conn friend-public-key-hex]
  (let [friend-db (get @db-conn friend-public-key-hex (df/empty-db))
        {:keys [puts delete-keys]} (await (pull-sync! friend-public-key-hex (:ordered friend-db)))
        updated (df/apply-records friend-db puts delete-keys)]
    (swap! db-conn assoc friend-public-key-hex updated)
    nil))

(defn ^Future watch-friends-loop!
  "Run for the life of the app: pull every friend once, then long-poll /watch. On
   each poke, pull just the friend that changed; on timeout, simply re-poll. Errors
   are logged and the loop continues (the next pull re-reconciles any gap)."
  [db-conn friend-public-key-hexes]
  (doseq [friend friend-public-key-hexes]
    (try (await (pull-friend! db-conn friend))
         (catch Exception e (prn "initial pull failed for" friend e))))
  (loop []
    (try
      (let [poked (await (watch-once! friend-public-key-hexes))]
        (when poked
          (await (pull-friend! db-conn poked))))
      (catch Exception e
        (prn "watch/pull error:" e)))
    (recur)))
