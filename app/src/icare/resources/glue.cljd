(ns icare.resources.glue
  (:require [icare.resources.state :refer [initialize-state! transact! db-conn default-initial-data default-physics]]
            [icare.resources.datafriend :as df]
            [icare.resources.pose :as pose]
            ["package:firebase_messaging/firebase_messaging.dart" :as firebase-messaging]
            ["package:nostr/nostr.dart" :refer [Keychain]]
            ["package:flutter_secure_storage/flutter_secure_storage.dart" :refer [FlutterSecureStorage]]))

(defn ^Future get-device-token-future []
  (let [messaging (firebase-messaging/FirebaseMessaging.instance)
        settings (await (.getNotificationSettings messaging))
        status (.-authorizationStatus settings)]
    (when (= status firebase-messaging/AuthorizationStatus.notDetermined)
      (await (.requestPermission messaging
                .alert true
                .sound true
                .badge true
                .provisional true)))
    (when-not (= status firebase-messaging/AuthorizationStatus.denied)
      (-> (.getToken messaging)
          (.then (fn [new-token]
                   new-token))
          (.catchError (fn [e]
                         (prn "Failed to get device token: " e)))))))

(defn ^Future get-secure-credentials []
  (let [storage (FlutterSecureStorage)
        contains-private-key? (await (.containsKey storage .key "private-key"))
        contains-public-key? (await (.containsKey storage .key "public-key"))]
    (cond
      (and contains-private-key? contains-public-key?)
      (let [private-key (await (.read storage .key "private-key"))
            public-key (await (.read storage .key "public-key"))]
        [private-key public-key])

      (and (not contains-private-key?) (not contains-public-key?))
      (let [{:flds [private public]} ^Keychain (.-generate Keychain)]
        (await (.write storage .key "private-key" .value private))
        (await (.write storage .key "public-key" .value public))
        [private public])

      :else (throw (Exception "Secure credentials exist partially")))))

(defn ^Future initialize-persisted-resources! [handle-network-data!]
  (let [;; Open datafriend database
        datafriend-db (await (df/open "icare"))
        _ (prn "Datafriend initialized with" (count (get-in datafriend-db [:eav])) "entities")

        ;; Get credentials
        [private-key public-key] (await (get-secure-credentials))
        _ (prn "Loaded credentials for pub-key:" public-key)

        ;; Populate default data if database is empty
        is-empty? (zero? (count (get-in datafriend-db [:eav])))
        datafriend-db (if is-empty?
                        (do
                          (prn "Populating default initial data...")
                          (let [new-db (df/transact datafriend-db (default-initial-data public-key))]
                            (prn "After populating, DB has entities:" (keys (:eav new-db)))
                            new-db))
                        datafriend-db)

        ;; Initialize state with populated db
        _ (initialize-state! datafriend-db)

        ;; One-time migrations, combined into a SINGLE transaction: lmdb allows one write
        ;; txn at a time and txnStart blocks the ui thread, so two fire-and-forget
        ;; transact! calls in the same synchronous stretch deadlock the whole app
        _ (let [db @db-conn
                ;; the expanded querido depends on widget-layer icon coordinates that don't
                ;; exist on a fresh launch, so we always start collapsed
                expanded-querido-id (get-in db [:eav :global/config :config/expanded-querido])
                ;; migrate queridos from the retired :config/queridos-order vector to physics poses
                queridos-order (get-in db [:eav :global/config :config/queridos-order])
                pose-adds (into {}
                                (map-indexed (fn [idx querido-id]
                                               [querido-id (pose/pose-attrs :home
                                                                            (+ 120.0 (* (mod idx 2) 160.0))
                                                                            (+ 240.0 (* (quot idx 2) 180.0)))])
                                             (vec (remove #(get-in db [:eav % :pose/canvas]) (or queridos-order [])))))
                ;; seed physics constants for dbs created before they existed
                add-map (cond-> pose-adds
                          (not (get-in db [:eav :global/physics])) (assoc :global/physics default-physics))
                retract-map (cond-> {}
                              expanded-querido-id (assoc-in [:global/config :config/expanded-querido] expanded-querido-id)
                              queridos-order (assoc-in [:global/config :config/queridos-order] queridos-order))]
            (when (or (seq add-map) (seq retract-map))
              (transact! {'add add-map 'retract retract-map})))

        ;; Get device token
        device-token (await (get-device-token-future))
        _ (prn "Device token:" device-token)

        ;; Store device token in db if we have one
        _ (when device-token
            (transact! {'add {:global/config {:config/device-token device-token}}}))]

    ;; Return db-conn for the UI to use
    db-conn))
