(ns icare.resources.state
  (:require ["package:uuid/uuid.dart" :refer [Uuid]]
            [icare.resources.pose :as pose]
            [icare.resources.datafriend :as df]))

(def uuid-generator (.-v4 (Uuid)))

;;This namespace holds the atomic reference to the datafriend database
;;The UI queries and transacts against db-conn directly
;;Transact using: (swap! db-conn df/transact diff)
;;Query using: (df/query @db-conn {entity {attribute 'value}})
;;
(defonce initialized? (atom false))

;;The db-conn atom holds the datafriend database: {:eav {...} :aev {...} :ave {...}}
(defonce db-conn (atom nil))

;;Call this function to initialize the db-conn
(defn initialize-state! [datafriend-db]
  (when-not @initialized?
    (prn "Initializing state with datafriend db")
    (reset! db-conn datafriend-db)
    (reset! initialized? true))
  db-conn)

;;Transact helper - swaps db-conn with the result of df/transact
(defn transact! [diff]
  "Transact a diff to the database. Returns the new db value."
  (swap! db-conn df/transact diff))

;;The feel of the ui is user data, these are just the defaults
(def default-physics
  {:physics/repulsion-strength 2200.0
   :physics/repulsion-radius 150.0
   :physics/damping 4.0
   :physics/static-friction 300.0
   :physics/wall-stiffness 200.0
   :physics/sleep-speed 4.0
   :physics/sleep-frames 12
   :physics/max-speed 3000.0})

;;Default initial data for a fresh database
(defn default-initial-data [pub-key]
  (let [example-task-uuid (uuid-generator)
        example-querido-uuid (uuid-generator)]
    {'add
     {;; Global config entity
      :global/config
      {:config/animated-assets ["penguin.webp"
                                "fish.webp"
                                "heart.gif"
                                "star.gif"
                                "movies.gif"
                                "dancing.gif"
                                "settings-slow.gif"]
       :config/current-screen :pages
       :config/user-pub-key pub-key
       :config/todo-list-order [example-task-uuid :add-task-task]}

      ;; Physics constants for the home canvas simulation
      :global/physics default-physics

      ;; Example task
      example-task-uuid
      {:task/title "Example task"
       :task/completed false
       :task/subitems []}

      ;; Example querido
      example-querido-uuid
      (merge {:querido/name "alex computer"
              :querido/asset "star.gif"
              :querido/pub-key "0299b1e9eee16c522767bc13c3a7247ce52b0113320ee1cb1da7e9eb85a000dc"
              :querido/task-order []}
             (pose/pose-attrs :home 130 260))

      ;; Add task placeholder
      :add-task-task
      {:task/is-add-task? true
       :task/title ""
       :task/completed false
       :task/subitems []}}}))
