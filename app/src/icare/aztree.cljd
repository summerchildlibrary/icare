(ns icare.aztree
  "An augmented zip-zip tree: a persistent, history-independent binary search tree
   where every node caches the XOR-folded fingerprint aggregate and the entry count
   of its subtree, so range-fingerprint, range-size and split-range run in O(log n).
   Purpose-built for in-process negentropy set reconciliation, where two endpoints
   localize their differences by exchanging XOR-folded fingerprints over
   successively narrower key ranges."
  (:require ["dart:convert" :as convert]))

(defn- ^int rotate-left-64 [^int value ^int rotation]
  (bit-or (bit-shift-left value rotation)
          (unsigned-bit-shift-right value (- 64 rotation))))

(defn- ^int finalization-mix-64 [^int value]
  (let [value (bit-xor value (unsigned-bit-shift-right value 33))
        value (* value -49064778989728563)
        value (bit-xor value (unsigned-bit-shift-right value 33))
        value (* value -4265267296055464877)
        value (bit-xor value (unsigned-bit-shift-right value 33))]
    value))

(defn fingerprint
  "Murmur3 x64 128 of the UTF-8 bytes of (pr-str value), returned as two 64-bit
   words [high low] and clamped away from all-zero (which is the XOR identity and
   would make an entry invisible in the aggregate). The single indirection every
   caller uses to fingerprint a value; changing hash functions happens here."
  [value]
  (let [^int murmur-constant-1 -8663945395140668459
        ^int murmur-constant-2 5545529020109919103
        string (pr-str value)
        bytes (convert/utf8.encode string)
        length (.-length bytes)
        block-count (quot length 16)]
    (loop [block-index 0 high (int 0) low (int 0)]
      (if (< block-index block-count)
        (let [block-base (* block-index 16)
              block-high (loop [byte-index 0 ^int accumulator (int 0)]
                           (if (< byte-index 8)
                             (recur (inc byte-index)
                                    (bit-or accumulator
                                            (bit-shift-left
                                             (bit-and (aget bytes (+ block-base byte-index)) 0xFF)
                                             (* byte-index 8))))
                             accumulator))
              block-low (loop [byte-index 0 ^int accumulator (int 0)]
                          (if (< byte-index 8)
                            (recur (inc byte-index)
                                   (bit-or accumulator
                                           (bit-shift-left
                                            (bit-and (aget bytes (+ block-base 8 byte-index)) 0xFF)
                                            (* byte-index 8))))
                            accumulator))
              ^int block-high (* (rotate-left-64 (* block-high murmur-constant-1) 31) murmur-constant-2)
              ^int high (bit-xor high block-high)
              ^int high (* (+ (rotate-left-64 high 27) low) 5)
              ^int high (+ high 1390208809)
              ^int block-low (* (rotate-left-64 (* block-low murmur-constant-2) 33) murmur-constant-1)
              ^int low (bit-xor low block-low)
              ^int low (* (+ (rotate-left-64 low 31) high) 5)
              ^int low (+ low 944331445)]
          (recur (inc block-index) high low))
        (let [tail-base (* block-count 16)
              tail-length (- length tail-base)
              tail-high (loop [byte-index 0 ^int accumulator (int 0)]
                          (if (and (< byte-index 8) (< (+ tail-base byte-index) length))
                            (recur (inc byte-index)
                                   (bit-or accumulator
                                           (bit-shift-left
                                            (bit-and (aget bytes (+ tail-base byte-index)) 0xFF)
                                            (* byte-index 8))))
                            accumulator))
              tail-low (loop [byte-index 8 ^int accumulator (int 0)]
                         (if (and (< byte-index 16) (< (+ tail-base byte-index) length))
                           (recur (inc byte-index)
                                  (bit-or accumulator
                                          (bit-shift-left
                                           (bit-and (aget bytes (+ tail-base byte-index)) 0xFF)
                                           (* (- byte-index 8) 8))))
                           accumulator))
              ^int high (if (pos? tail-length)
                          (bit-xor high (* (rotate-left-64 (* tail-high murmur-constant-1) 31) murmur-constant-2))
                          high)
              ^int low (if (> tail-length 8)
                         (bit-xor low (* (rotate-left-64 (* tail-low murmur-constant-2) 33) murmur-constant-1))
                         low)
              ^int high (bit-xor high length)
              ^int low (bit-xor low length)
              ^int high (+ high low)
              ^int low (+ low high)
              ^int high (finalization-mix-64 high)
              ^int low (finalization-mix-64 low)
              ^int high (+ high low)
              ^int low (+ low high)]
          (if (and (zero? high) (zero? low))
            [1 0]
            [high low]))))))

(defn- ^int trailing-zeros-64 [^int value]
  (loop [value value trailing-zeros 0]
    (if (or (= trailing-zeros 64) (odd? value))
      trailing-zeros
      (recur (unsigned-bit-shift-right value 1) (inc trailing-zeros)))))

(deftype AZNode
  [entry-key
   entry-value
   ^int fingerprint-high
   ^int fingerprint-low
   ^int aggregate-high
   ^int aggregate-low
   ^int subtree-count
   left
   right]
  :type-only true)

(defn- ^int node-count [node]
  (if (nil? node) 0 (.-subtree-count ^AZNode node)))

(defn- ^int node-aggregate-high [node]
  (if (nil? node) 0 (.-aggregate-high ^AZNode node)))

(defn- ^int node-aggregate-low [node]
  (if (nil? node) 0 (.-aggregate-low ^AZNode node)))

(defn- ^AZNode make-node
  [entry-key entry-value ^int fingerprint-high ^int fingerprint-low left right]
  (AZNode entry-key entry-value fingerprint-high fingerprint-low
    (bit-xor (node-aggregate-high left) fingerprint-high (node-aggregate-high right))
    (bit-xor (node-aggregate-low left) fingerprint-low (node-aggregate-low right))
    (+ 1 (node-count left) (node-count right))
    left right))

(defn- ^bool outranks?
  [^int candidate-fingerprint-high ^int candidate-fingerprint-low candidate-key
   ^int incumbent-fingerprint-high ^int incumbent-fingerprint-low incumbent-key
   compare-keys]
  (let [candidate-rank (trailing-zeros-64 candidate-fingerprint-high)
        incumbent-rank (trailing-zeros-64 incumbent-fingerprint-high)]
    (cond
      (not= candidate-rank incumbent-rank)
      (> candidate-rank incumbent-rank)

      (not= candidate-fingerprint-low incumbent-fingerprint-low)
      (> candidate-fingerprint-low incumbent-fingerprint-low)

      :else
      (neg? (compare-keys candidate-key incumbent-key)))))

(defn- unzip
  [^AZNode? node split-key compare-keys]
  (if (nil? node)
    [nil nil]
    (let [comparison (compare-keys split-key (.-entry-key node))]
      (if (neg? comparison)
        (let [[less greater] (unzip (.-left node) split-key compare-keys)]
          [less (make-node (.-entry-key node) (.-entry-value node)
                           (.-fingerprint-high node) (.-fingerprint-low node)
                           greater (.-right node))])
        (let [[less greater] (unzip (.-right node) split-key compare-keys)]
          [(make-node (.-entry-key node) (.-entry-value node)
                      (.-fingerprint-high node) (.-fingerprint-low node)
                      (.-left node) less)
           greater])))))

(defn- ^AZNode? zip
  [^AZNode? less ^AZNode? greater compare-keys]
  (cond
    (nil? less) greater
    (nil? greater) less
    :else
    (let [^AZNode less-node less
          ^AZNode greater-node greater]
      (if (outranks? (.-fingerprint-high less-node) (.-fingerprint-low less-node) (.-entry-key less-node)
                     (.-fingerprint-high greater-node) (.-fingerprint-low greater-node) (.-entry-key greater-node)
                     compare-keys)
        (make-node (.-entry-key less-node) (.-entry-value less-node)
                   (.-fingerprint-high less-node) (.-fingerprint-low less-node)
                   (.-left less-node) (zip (.-right less-node) greater compare-keys))
        (make-node (.-entry-key greater-node) (.-entry-value greater-node)
                   (.-fingerprint-high greater-node) (.-fingerprint-low greater-node)
                   (zip less (.-left greater-node) compare-keys) (.-right greater-node))))))

(defn- ^AZNode node-insert
  [^AZNode? node insert-key insert-value ^int fingerprint-high ^int fingerprint-low compare-keys]
  (let [placement (cond
                    (nil? node) :place
                    (outranks? fingerprint-high fingerprint-low insert-key
                               (.-fingerprint-high node) (.-fingerprint-low node) (.-entry-key node)
                               compare-keys) :place
                    (neg? (compare-keys insert-key (.-entry-key node))) :go-left
                    :else :go-right)]
    (case placement
      :place
      (let [[less greater] (unzip node insert-key compare-keys)]
        (make-node insert-key insert-value fingerprint-high fingerprint-low less greater))

      :go-left
      (make-node (.-entry-key node) (.-entry-value node)
                 (.-fingerprint-high node) (.-fingerprint-low node)
                 (node-insert (.-left node) insert-key insert-value fingerprint-high fingerprint-low compare-keys)
                 (.-right node))

      :go-right
      (make-node (.-entry-key node) (.-entry-value node)
                 (.-fingerprint-high node) (.-fingerprint-low node)
                 (.-left node)
                 (node-insert (.-right node) insert-key insert-value fingerprint-high fingerprint-low compare-keys)))))

(defn- node-remove
  [^AZNode? node remove-key compare-keys]
  (let [action (cond
                 (nil? node) :missing
                 (zero? (compare-keys remove-key (.-entry-key node))) :remove-here
                 (neg? (compare-keys remove-key (.-entry-key node))) :go-left
                 :else :go-right)]
    (case action
      :missing
      node

      :remove-here
      (zip (.-left node) (.-right node) compare-keys)

      :go-left
      (let [new-left (node-remove (.-left node) remove-key compare-keys)]
        (if (identical? new-left (.-left node))
          node
          (make-node (.-entry-key node) (.-entry-value node)
                     (.-fingerprint-high node) (.-fingerprint-low node)
                     new-left (.-right node))))

      :go-right
      (let [new-right (node-remove (.-right node) remove-key compare-keys)]
        (if (identical? new-right (.-right node))
          node
          (make-node (.-entry-key node) (.-entry-value node)
                     (.-fingerprint-high node) (.-fingerprint-low node)
                     (.-left node) new-right))))))

(defn- node-get [^AZNode? node lookup-key compare-keys not-found]
  (loop [^AZNode? node node]
    (if (nil? node)
      not-found
      (let [comparison (compare-keys lookup-key (.-entry-key node))]
        (cond
          (zero? comparison) (.-entry-value node)
          (neg? comparison) (recur (.-left node))
          :else (recur (.-right node)))))))

(defn- prefix-fingerprint
  [^AZNode? node boundary-key compare-keys ^int accumulator-high ^int accumulator-low]
  (if (nil? node)
    [accumulator-high accumulator-low]
    (let [comparison (compare-keys boundary-key (.-entry-key node))]
      (cond
        (neg? comparison)
        (prefix-fingerprint (.-left node) boundary-key compare-keys accumulator-high accumulator-low)

        (pos? comparison)
        (prefix-fingerprint (.-right node) boundary-key compare-keys
                            (bit-xor accumulator-high (node-aggregate-high (.-left node)) (.-fingerprint-high node))
                            (bit-xor accumulator-low (node-aggregate-low (.-left node)) (.-fingerprint-low node)))

        :else
        [(bit-xor accumulator-high (node-aggregate-high (.-left node)))
         (bit-xor accumulator-low (node-aggregate-low (.-left node)))]))))

(defn- ^int prefix-count
  [^AZNode? node boundary-key compare-keys ^int accumulator]
  (if (nil? node)
    accumulator
    (let [comparison (compare-keys boundary-key (.-entry-key node))]
      (cond
        (neg? comparison)
        (prefix-count (.-left node) boundary-key compare-keys accumulator)

        (pos? comparison)
        (prefix-count (.-right node) boundary-key compare-keys (+ accumulator (node-count (.-left node)) 1))

        :else
        (+ accumulator (node-count (.-left node)))))))

(defn- key-in-range? [compare-keys low high candidate-key]
  (and (or (nil? low) (<= (compare-keys low candidate-key) 0))
       (or (nil? high) (neg? (compare-keys candidate-key high)))))

(defn- subtree-overlaps-range? [compare-keys low high subtree-low subtree-high]
  (and (or (nil? high) (nil? subtree-low) (neg? (compare-keys subtree-low high)))
       (or (nil? low) (nil? subtree-high) (<= (compare-keys low subtree-high) 0))))

(defn- range-entries
  [^AZNode? node low high subtree-low subtree-high compare-keys accumulator]
  (cond
    (nil? node) accumulator
    (not (subtree-overlaps-range? compare-keys low high subtree-low subtree-high)) accumulator
    :else
    (let [node-key (.-entry-key node)
          accumulator (range-entries (.-left node) low high subtree-low node-key compare-keys accumulator)
          accumulator (if (key-in-range? compare-keys low high node-key)
                        (conj accumulator [node-key (.-entry-value node)])
                        accumulator)]
      (range-entries (.-right node) low high node-key subtree-high compare-keys accumulator))))

(defn- node-reduce-kv [^AZNode? node reducing-fn accumulator]
  (if (nil? node)
    accumulator
    (let [accumulator (node-reduce-kv (.-left node) reducing-fn accumulator)]
      (if (reduced? accumulator)
        accumulator
        (let [accumulator (reducing-fn accumulator (.-entry-key node) (.-entry-value node))]
          (if (reduced? accumulator)
            accumulator
            (node-reduce-kv (.-right node) reducing-fn accumulator)))))))

(declare ->aztree)

(deftype AZTree [root compare-keys]
  :type-only true

  IAssociative
  (-assoc [tree entry-key entry-value]
    (let [[fingerprint-high fingerprint-low] (fingerprint entry-value)
          root (node-remove root entry-key compare-keys)
          root (node-insert root entry-key entry-value fingerprint-high fingerprint-low compare-keys)]
      (->aztree root compare-keys)))

  IMap
  (-dissoc [tree entry-key]
    (->aztree (node-remove root entry-key compare-keys) compare-keys))

  ILookup
  (-lookup [tree entry-key] (node-get root entry-key compare-keys nil))
  (-lookup [tree entry-key not-found] (node-get root entry-key compare-keys not-found))
  (-contains-key? [tree entry-key]
    (not (identical? tree (node-get root entry-key compare-keys tree))))

  ICounted
  (-count [tree] (node-count root))

  IReduce
  (-reduce [tree reducing-fn]
    (node-reduce-kv root (fn [accumulator k v] (reducing-fn accumulator [k v])) nil))
  (-reduce [tree reducing-fn initial-value]
    (unreduced (node-reduce-kv root (fn [accumulator k v] (reducing-fn accumulator [k v])) initial-value)))

  IKVReduce
  (-kv-reduce [tree reducing-fn initial-value]
    (unreduced (node-reduce-kv root reducing-fn initial-value)))

  ISeqable
  (-seq [tree]
    (seq (node-reduce-kv root (fn [accumulator k v] (conj accumulator [k v])) [])))

  IEmptyableCollection
  (-empty [tree] (->aztree nil compare-keys))

  IFn
  (-invoke [tree entry-key] (node-get root entry-key compare-keys nil))
  (-invoke [tree entry-key not-found] (node-get root entry-key compare-keys not-found)))

(defn- ->aztree [root compare-keys]
  (AZTree root compare-keys))

(defn atree
  "An empty augmented zip-zip tree ordered by `compare` (or a supplied 2-argument
   comparator). It supports the map operations assoc, dissoc, get, count, seq,
   reduce and reduce-kv, plus the negentropy range operations below. Keys are
   expected to be [timestamp fingerprint] pairs but any comparable key works.
   assoc fingerprints its value automatically."
  ([] (atree compare))
  ([compare-keys] (->aztree nil compare-keys)))

(defn range-fingerprint
  "XOR-folded fingerprint [high low] of every entry with key in the half-open
   range [low, high), computed as prefix-fingerprint(high) XOR prefix-fingerprint(low).
   A nil bound is unbounded on that side; an empty range folds to [0 0]. This is
   what two endpoints exchange to test whether a key range matches without
   transferring its contents."
  [^AZTree tree low high]
  (let [root (.-root tree)
        compare-keys (.-compare-keys tree)
        [prefix-high-high prefix-high-low] (if (nil? high)
                                             [(node-aggregate-high root) (node-aggregate-low root)]
                                             (prefix-fingerprint root high compare-keys 0 0))
        [prefix-low-high prefix-low-low] (if (nil? low)
                                           [0 0]
                                           (prefix-fingerprint root low compare-keys 0 0))]
    [(bit-xor prefix-high-high prefix-low-high)
     (bit-xor prefix-high-low prefix-low-low)]))

(defn ^int range-size
  "Number of entries with key in the half-open range [low, high), computed as
   prefix-count(high) - prefix-count(low). A nil bound is unbounded on that side."
  [^AZTree tree low high]
  (let [root (.-root tree)
        compare-keys (.-compare-keys tree)
        prefix-at-high (if (nil? high) (node-count root) (prefix-count root high compare-keys 0))
        prefix-at-low (if (nil? low) 0 (prefix-count root low compare-keys 0))]
    (- prefix-at-high prefix-at-low)))

(defn range-items
  "Ordered vector of [key value] for entries with key in [low, high). Used at the
   leaves of reconciliation once a range is small enough to send outright."
  [^AZTree tree low high]
  (range-entries (.-root tree) low high nil nil (.-compare-keys tree) []))

(defn split-range
  "Divide [low, high) into at most `bucket-count` consecutive sub-ranges of roughly
   equal entry count, returned as a vector of [sub-low sub-high] bounds that cover
   [low, high) with no gaps or overlaps. Boundaries fall on actual keys, and fewer
   than `bucket-count` sub-ranges are returned when the range holds fewer entries.
   This is the recursive subdivision negentropy uses to localize a differing range."
  [tree low high bucket-count]
  (let [items (range-items tree low high)
        total (count items)]
    (if (<= total 1)
      (if (zero? total) [] [[low high]])
      (let [buckets (min bucket-count total)
            per-bucket (quot (+ total buckets -1) buckets)
            boundary-keys (loop [item-index per-bucket boundaries []]
                            (if (< item-index total)
                              (recur (+ item-index per-bucket) (conj boundaries (first (nth items item-index))))
                              boundaries))
            edges (concat [low] boundary-keys [high])]
        (mapv (fn [range-low range-high] [range-low range-high]) edges (rest edges))))))
